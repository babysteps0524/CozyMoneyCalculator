---
import AdSlot from '../common/AdSlot.astro';
import CalculatorDetails from './CalculatorDetails.astro';
import type { CalculatorGuidance } from '../../lib/calculators/guidance';

type Props =
  | {
      mode: 'custom';
      title?: never;
      description?: never;
      guidance?: never;
    }
  | {
      mode?: 'standard';
      title: string;
      description: string;
      guidance: CalculatorGuidance;
    };

const { mode = 'standard' } = Astro.props;
const isCustom = mode === 'custom';
---

{isCustom ? (
  <slot />
) : (
  <>
    <section
      class="cm-card"
      w="full"
      p="5 md:7"
      aria-labelledby="calculator-shell-title"
    >
      <header mb="6">
        <p m="0" text="sm" font="700" text-primary>
          CALCULATOR
        </p>
        <h2
          id="calculator-shell-title"
          m="0"
          mt="1"
          text="xl md:2xl"
          font="800"
        >
          {Astro.props.title}
        </h2>
        <p
          m="0"
          mt="2"
          text="sm"
          leading="6"
          text-text-muted
          dark="text-dark-text-muted"
        >
          {Astro.props.description}
        </p>
      </header>

      <slot />

      <AdSlot slot={import.meta.env.PUBLIC_ADSENSE_SLOT_CALCULATOR || ''} />

      <div
        mt="6"
        rounded="2xl"
        border="1"
        border-border
        bg="surface-muted"
        p="5"
        dark="border-dark-border bg-dark-surface-muted"
      >
        <h3 m="0" text="base" font="750">
          이용 전 확인
        </h3>
        <ul
          m="0"
          mt="3"
          pl="5"
          text="sm"
          leading="7"
          text-text-muted
          dark="text-dark-text-muted"
        >
          <li>
            입력값은 이 페이지의 브라우저에서 계산하며 계산기 자체가 입력값을
            별도 저장하지 않습니다.
          </li>
          <li>
            결과는 이해를 돕기 위한 참고용 계산값이며 실제 금융·세금·노무 기준과
            다를 수 있습니다.
          </li>
          <li>
            세율, 한도, 공제, 자격요건 등은 개인의 조건과 적용 시점에 따라
            달라질 수 있습니다.
          </li>
          <li>
            중요한 계약·신고·대출·세금·급여 결정 전에는 관계 기관 또는 전문가의
            최신 기준을 확인하세요.
          </li>
        </ul>
      </div>

      <p
        m="0"
        mt="5"
        text="xs sm:sm"
        leading="6"
        text-text-subtle
        dark="text-dark-text-subtle"
      >
        CozyMoney는 계산 결과의 정확성이나 특정 금융상품·세금·노무 결과를
        보장하지 않습니다.
      </p>
    </section>

    {Astro.props.guidance ? (
      <CalculatorDetails content={Astro.props.guidance} />
    ) : null}
  </>
)}
