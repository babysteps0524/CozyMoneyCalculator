---
import AdSlot from '../common/AdSlot.astro';

interface Props {
  kind: string;
  title: string;
  description: string;
}
const { kind, title, description } = Astro.props;

const guidance: Record<string, { intro: string; steps: string[]; formula: string; basis: string; cautions: string[] }> = {
  compound: { intro: '원금과 연이율을 바탕으로 일정 기간 동안 이자가 다시 원금에 합산되는 복리 효과를 단순 추정합니다.', steps: ['초기금액에 연이율과 기간을 적용합니다.', '추가납입액이 있으면 기간별 납입액도 복리로 증가한다고 가정합니다.', '최종금액에서 납입 원금을 빼 이자 부분을 확인합니다.'], formula: '기본식은 미래금액 = 원금 × (1 + 연이율)ⁿ입니다.', basis: '실제 금융상품은 이자 계산일, 납입일, 우대금리, 중도해지 조건 등 상품 약관이 우선합니다.', cautions: ['세금과 상품별 우대조건은 반영하지 않습니다.', '실제 적립식 상품은 납입시점에 따라 이자가 달라질 수 있습니다.'] },
  dsr: { intro: 'DSR은 연소득에 비해 1년 동안 갚아야 하는 대출 원리금이 어느 정도인지 보는 비율입니다.', steps: ['연소득을 확인합니다.', '기존 대출과 신규 대출의 연간 원리금 상환액을 합산합니다.', '합산한 연간 원리금을 연소득으로 나누고 100을 곱합니다.'], formula: 'DSR(%) = 연간 원리금 상환액 ÷ 연소득 × 100.', basis: '실제 금융기관은 금융당국의 가계대출 관리기준과 금융회사별 심사기준을 함께 적용합니다.', cautions: ['대출 종류와 상환기간, 금리, 소득 인정방법에 따라 실제 심사값이 달라질 수 있습니다.', '이 결과만으로 대출 가능 여부를 판단할 수 없습니다.'] },
  dti: { intro: 'DTI는 연소득 대비 주택담보대출 원리금과 기타 대출 이자상환액의 비율을 단순 계산합니다.', steps: ['연소득을 입력합니다.', '주택담보대출 원리금과 기타 대출 이자를 합산합니다.', '합산액을 연소득으로 나눕니다.'], formula: 'DTI(%) = (주택담보대출 연간 원리금 + 기타 대출 연간 이자) ÷ 연소득 × 100.', basis: '실제 적용 범위와 산정방법은 대출상품과 당시 금융 규정에 따라 달라질 수 있습니다.', cautions: ['금융기관의 실제 DTI 산정과 동일하지 않습니다.', '소득·부채 인정범위는 최신 금융기관 기준을 확인해야 합니다.'] },
  severance: { intro: '퇴직금은 계속근로기간과 평균임금을 기준으로 산정합니다. 현재 계산기는 월 평균임금을 입력받아 빠르게 예상합니다.', steps: ['퇴직 전 임금자료로 평균임금을 확인합니다.', '계속근로일수를 확인합니다.', '1일 평균임금 × 30일 × 계속근로일수 ÷ 365 형태로 계산합니다.'], formula: '퇴직금 = 1일 평균임금 × 30일 × 계속근로일수 ÷ 365.', basis: '고용노동부는 근로자퇴직급여 보장법 제8조와 근로기준법상 평균임금 기준에 따라 이 산식을 안내합니다.', cautions: ['평균임금은 일반적으로 퇴직 사유 발생 전 3개월 임금총액과 그 기간의 총일수를 기준으로 합니다.', '평균임금이 통상임금보다 적으면 통상임금을 기준으로 보는 경우가 있습니다.'] },
  weekly: { intro: '시급과 주 소정근로시간을 이용해 주급과 주휴수당을 단순 추정합니다.', steps: ['시급과 주 소정근로시간을 입력합니다.', '기본 주급을 계산합니다.', '주휴수당 요건을 충족한다고 가정해 단순 주휴수당을 더합니다.'], formula: '기본 주급 = 시급 × 주 소정근로시간. 이 계산기는 주휴수당을 단순화해 계산합니다.', basis: '주휴 관련 판단은 근로기준법 제55조 등 관련 규정과 고용노동부 안내를 확인해야 합니다.', cautions: ['소정근로일 개근 여부와 근로시간 등 실제 조건에 따라 달라집니다.', '근로계약서의 소정근로시간과 임금항목을 확인해야 합니다.'] },
  vacation: { intro: '미사용 연차일수와 1일 통상임금을 곱해 연차수당을 단순 추정합니다.', steps: ['1일 통상임금을 확인합니다.', '미사용 연차일수를 입력합니다.', '두 값을 곱합니다.'], formula: '단순 연차수당 = 1일 통상임금 × 미사용 연차일수.', basis: '연차휴가의 발생·사용 기준은 근로기준법 제60조 등을 기준으로 판단합니다.', cautions: ['통상임금의 범위와 연차 사용촉진 여부에 따라 실제 지급액이 달라질 수 있습니다.', '연차 소멸 여부와 사용촉진 절차를 별도로 확인해야 합니다.'] },
  unemployment: { intro: '구직급여는 수급자격과 피보험기간, 이직사유 등에 따라 지급 여부와 기간이 달라집니다. 이 계산기는 단순 예상값입니다.', steps: ['1일 평균임금과 예상 지급일수를 입력합니다.', '평균임금의 60%를 단순 적용합니다.', '예상 1일 금액에 지급일수를 곱합니다.'], formula: '단순 예상액 = 1일 평균임금 × 60% × 예상 지급일수.', basis: '실제 구직급여는 고용보험법에 따른 수급자격, 기초일액, 소정급여일수와 상·하한액을 적용합니다.', cautions: ['실제 수급자격과 지급기간을 반영하지 않습니다.', '신청 전 고용24 또는 고용센터의 최신 기준을 확인해야 합니다.'] },
  vat: { intro: '일반적인 10% 과세 거래에서 공급가액과 부가가치세를 서로 환산합니다.', steps: ['공급가액을 입력하면 10%를 적용합니다.', '합계금액을 입력하면 11로 나누어 부가세를 역산합니다.', '실제 신고에서는 매입세액과 공제세액을 별도로 반영합니다.'], formula: '매출세액 = 공급가액 × 10%. 합계금액에서 역산하는 부가세 = 합계금액 ÷ 11.', basis: '국세청은 일반적인 매출세액에 10% 세율을 적용하고 매입세액을 차감해 납부세액을 계산한다고 안내합니다.', cautions: ['면세·영세율·간이과세 등은 별도 규정이 적용됩니다.', '실제 신고·납부세액은 이 계산기와 다를 수 있습니다.'] },
  incomeTax: { intro: '과세표준에 누진세율 구조를 단순 적용해 산출세액을 확인합니다.', steps: ['과세표준을 확인합니다.', '해당 구간의 세율과 누진공제를 적용합니다.', '실제 결정세액과 구분해 결과를 확인합니다.'], formula: '누진세율 구조의 기본 형태는 과세표준 × 세율 - 누진공제입니다.', basis: '소득세법의 과세표준·세율 체계를 참고합니다. 실제 신고에는 소득공제·세액공제·감면 등이 추가됩니다.', cautions: ['현재 계산기는 실제 종합소득세·근로소득세 결정세액을 계산하지 않습니다.', '지방소득세와 공제·감면은 별도입니다.'] },
  acquisition: { intro: '취득가액과 사용자가 입력한 세율을 이용해 취득세를 단순 계산합니다.', steps: ['취득가액 또는 과세표준을 확인합니다.', '거래유형에 맞는 세율을 확인합니다.', '과세표준에 세율을 적용합니다.'], formula: '단순 취득세 = 과세표준 × 적용세율.', basis: '지방세법 및 관련 시행령의 취득세 과세표준·세율 규정을 기준으로 실제 세액이 결정됩니다.', cautions: ['주택 수, 취득원인, 주택유형 등에 따라 세율이 달라질 수 있습니다.', '지방교육세·농어촌특별세 등은 포함하지 않습니다.'] },
  property: { intro: '과세표준과 입력한 재산세율을 곱해 재산세를 단순 추정합니다.', steps: ['과세표준을 확인합니다.', '과세대상에 맞는 세율을 확인합니다.', '과세표준에 세율을 곱합니다.'], formula: '단순 재산세 = 과세표준 × 입력 세율.', basis: '지방세법의 재산세 과세표준과 세율 체계를 참고합니다.', cautions: ['주택·토지·건축물 등 과세대상별 계산방법이 다릅니다.', '지방교육세와 세부담상한 등은 별도입니다.'] },
  capitalGain: { intro: '양도가액에서 취득가액과 필요경비를 빼 양도차익을 구한 뒤 입력한 가정 세율을 적용합니다.', steps: ['양도가액을 확인합니다.', '취득가액과 필요경비를 차감합니다.', '남은 양도차익에 입력한 가정 세율을 적용합니다.'], formula: '단순 양도차익 = 양도가액 - 취득가액 - 필요경비.', basis: '소득세법의 양도소득 과세체계를 참고합니다. 자산 종류와 보유기간 등에 따라 공제·세율이 달라집니다.', cautions: ['보유기간, 다주택 여부, 기본공제, 장기보유특별공제 등을 반영하지 않습니다.', '실제 양도소득세 신고용 계산이 아닙니다.'] },
  carTax: { intro: '배기량과 입력한 세율을 곱해 자동차세를 단순 추정합니다.', steps: ['배기량을 확인합니다.', '차종에 맞는 세율을 확인합니다.', '배기량과 세율을 곱합니다.'], formula: '단순 자동차세 = 배기량 × 입력 세율.', basis: '지방세법상 자동차세 과세체계를 참고합니다.', cautions: ['차종과 용도에 따라 과세방법이 달라질 수 있습니다.', '차령 경감과 지방교육세 등은 완전히 반영하지 않습니다.'] },
  rent: { intro: '보증금과 월세를 같은 연간 기준으로 환산해 주거비를 비교합니다.', steps: ['보증금에 전월세 전환율을 적용합니다.', '월세에 12개월을 곱합니다.', '두 환산액을 합산합니다.'], formula: '보증금 환산액 = 보증금 × 전환율. 연간 월세 = 월세 × 12.', basis: '주택임대차보호법상 전월세전환율 관련 규정을 참고하되 실제 계약조건을 우선 확인합니다.', cautions: ['법정 전환율 상한과 임대인이 제시하는 전환율은 구분해야 합니다.', '계약 변경 가능 여부를 판단하는 계산기는 아닙니다.'] },
  brokerage: { intro: '거래금액에 중개보수율을 적용해 예상 중개보수를 계산합니다.', steps: ['거래유형을 확인합니다.', '해당 금액구간의 법정 상한요율을 확인합니다.', '거래금액에 요율을 적용합니다.'], formula: '단순 중개보수 = 거래금액 × 입력 중개보수율.', basis: '공인중개사법 및 시행규칙의 중개보수 한도 규정을 참고합니다.', cautions: ['거래유형과 금액구간에 따라 상한요율이 달라집니다.', '부가가치세가 별도로 적용될 수 있습니다.'] },
  leaseLoan: { intro: '임차보증금에 대출비율을 적용해 예상 대출금과 단순 연이자를 계산합니다.', steps: ['임차보증금을 입력합니다.', '대출비율을 적용합니다.', '예상 대출금에 연이율을 적용합니다.'], formula: '예상 대출금 = 임차보증금 × 대출비율. 단순 연이자 = 대출금 × 연이율.', basis: '실제 전세대출 한도와 금리는 보증기관·금융회사·주택·소득·부채 조건에 따라 결정됩니다.', cautions: ['입력한 비율이 실제 대출한도를 의미하지 않습니다.', '보증료·우대금리·상환방식 등은 별도입니다.'] },
  percentage: { intro: '기준값에서 특정 퍼센트가 차지하는 금액을 계산합니다.', steps: ['기준값을 입력합니다.', '퍼센트를 입력합니다.', '기준값에 퍼센트를 곱하고 100으로 나눕니다.'], formula: '퍼센트 금액 = 기준값 × 퍼센트 ÷ 100.', basis: '일반적인 백분율 산식을 사용합니다.', cautions: ['세금·수수료 등 실제 거래에서는 별도의 적용 기준과 반올림 규칙이 있을 수 있습니다.'] },
  monthlySalary: { intro: '연봉을 12개월로 나누어 세전 월 급여를 단순 추정합니다.', steps: ['연봉에서 별도 금액을 차감합니다.', '남은 금액을 12개월로 나눕니다.', '세전 월 급여를 확인합니다.'], formula: '단순 월 급여 = (연봉 - 연간 별도 금액) ÷ 12.', basis: '실제 임금 구성과 지급주기는 근로계약에 따라 달라질 수 있습니다.', cautions: ['상여금 지급월과 비과세 수당은 실제 급여명세서와 다를 수 있습니다.', '실수령액 계산에는 세금과 4대보험 등이 추가됩니다.'] },
  hourlyWage: { intro: '월 급여를 월 근로시간으로 나누어 단순 시급을 계산하고 최저임금과 비교할 때 참고할 수 있습니다.', steps: ['월 급여와 월 근로시간을 입력합니다.', '월 급여를 월 근로시간으로 나눕니다.', '필요하면 해당 연도의 최저임금과 비교합니다.'], formula: '단순 시급 = 월 급여 ÷ 월 근로시간.', basis: '고용노동부는 2026년 최저임금을 시간급 10,320원, 월급 2,156,880원으로 안내하며 월급은 주 40시간과 유급주휴시간을 포함한 환산 기준입니다.', cautions: ['최저임금 위반 여부는 임금항목의 산입범위와 법정 근로시간 기준을 따져야 합니다.', '연장·야간·휴일근로수당과 주휴수당 포함 여부를 확인해야 합니다.'] },
};

const currentGuidance = guidance[kind] ?? {
  intro: '입력값을 바탕으로 계산 결과를 확인합니다.',
  steps: ['입력값을 확인합니다.', '계산하기 버튼을 눌러 결과를 확인합니다.'],
  formula: '입력값에 해당 계산기의 기본 산식을 적용합니다.',
  basis: '계산 결과는 이해를 돕기 위한 참고용 값입니다.',
  cautions: ['실제 금융·세금·노무 기준은 개인 조건과 적용 시점에 따라 달라질 수 있습니다.'],
};
---

<section class="cm-card" data-calculator={kind} p="5 md:7">
  <div flex="~" items-start justify-between gap="4" mb="6">
    <div>
      <p m="0" text="sm" font="700" text-primary>
        CALCULATOR
      </p>
      <h2 m="0" mt="1" text="xl md:2xl" font="800">
        {title}
      </h2>
      <p
        m="0"
        mt="2"
        text="sm"
        leading="6"
        text-text-muted
        dark="text-dark-text-muted"
      >
        {description}
      </p>
    </div>
  </div>
  <div id="fields" grid="~ cols-1 md:cols-2" gap="4"></div>
  <div
    id="result"
    mt="5"
    rounded="2xl"
    bg="primary/10"
    p="5"
    dark="bg-[oklch(25%_0.04_250)]"
  >
    <p m="0" text="sm" text-text-muted dark="text-dark-text-muted">
      계산 결과
    </p>
    <div id="result-value" mt="2" text="2xl md:3xl" font="800" text-primary>
      -
    </div>
    <div
      id="result-detail"
      mt="3"
      text="sm"
      leading="7"
      text-text-muted
      dark="text-dark-text-muted"
    ></div>
  </div>
  <div grid="~ cols-1 sm:cols-2" gap="3" mt="5">
    <button id="calculate" class="cm-button-primary" py="3">
      계산하기
    </button>
    <button id="reset" class="cm-button-secondary" py="3">
      초기화
    </button>
  </div>
  <AdSlot slot={import.meta.env.PUBLIC_ADSENSE_SLOT_CALCULATOR || ''} />

  <div mt="8" grid="~ cols-1 lg:cols-2" gap="4">
    <section rounded="2xl" border="1" border-border bg="surface-muted" p="5" dark="border-dark-border dark:bg-dark-surface-muted">
      <h3 m="0" text="sm" font="750">계산기 사용 목적</h3>
      <p m="0" mt="3" text="sm" leading="7" text-text-muted dark="text-dark-text-muted">{currentGuidance.intro}</p>
    </section>
    <section rounded="2xl" border="1" border-border bg="surface-muted" p="5" dark="border-dark-border dark:bg-dark-surface-muted">
      <h3 m="0" text="sm" font="750">계산 방법</h3>
      <ol m="0" mt="3" pl="5" text="sm" leading="7" text-text-muted dark="text-dark-text-muted">
        {currentGuidance.steps.map((step) => <li>{step}</li>)}
      </ol>
    </section>
    <section rounded="2xl" border="1" border-border bg="surface-muted" p="5" dark="border-dark-border dark:bg-dark-surface-muted">
      <h3 m="0" text="sm" font="750">계산 공식</h3>
      <p m="0" mt="3" text="sm" leading="7" text-text-muted dark="text-dark-text-muted">{currentGuidance.formula}</p>
    </section>
    <section rounded="2xl" border="1" border-border bg="surface-muted" p="5" dark="border-dark-border dark:bg-dark-surface-muted">
      <h3 m="0" text="sm" font="750">공식 기준</h3>
      <p m="0" mt="3" text="sm" leading="7" text-text-muted dark="text-dark-text-muted">{currentGuidance.basis}</p>
    </section>
  </div>
  <section mt="4" rounded="2xl" border="1" border="danger/20" bg="danger-surface" p="5">
    <h3 m="0" text="sm" font="750">주의사항</h3>
    <ul m="0" mt="3" pl="5" text="sm" leading="7" text-text-muted dark="text-dark-text-muted">
      {currentGuidance.cautions.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <div
    mt="6"
    rounded="2xl"
    border="1"
    border-border
    bg="surface-muted"
    p="5"
    dark="border-dark-border dark:bg-dark-surface-muted"
  >
    <h3 m="0" text="sm" font="750">
      이용 전 확인
    </h3>
    <ul
      m="0"
      mt="3"
      pl="5"
      text="sm"
      leading="7"
      text-text-muted
      dark="text-dark-text-muted"
    >
      <li>
        입력값은 이 페이지의 브라우저에서 계산하며 계산기 자체가 입력값을 별도
        저장하지 않습니다.
      </li>
      <li>
        결과는 이해를 돕기 위한 참고용 계산값이며 실제 금융·세금·노무 기준과
        다를 수 있습니다.
      </li>
      <li>
        세율, 한도, 공제, 자격요건 등은 개인의 조건과 적용 시점에 따라 달라질 수
        있습니다.
      </li>
      <li>
        중요한 계약·신고·대출·세금·급여 결정 전에는 관계 기관 또는 전문가의 최신
        기준을 확인하세요.
      </li>
    </ul>
  </div>
  <p
    m="0"
    mt="5"
    text="xs sm:sm"
    leading="6"
    text-text-subtle
    dark="text-dark-text-subtle"
  >
    CozyMoney는 계산 결과의 정확성이나 특정 금융상품·세금·노무 결과를 보장하지
    않습니다.
  </p>
</section>

<script>
  import { bindNumberControls } from '../../lib/calculators/number-input';

  const root = document.querySelector<HTMLElement>('[data-calculator]');
  if (root) {
    const kind = root.dataset.calculator!;
    const fields = root.querySelector<HTMLElement>('#fields')!;
    const out = root.querySelector<HTMLElement>('#result-value')!;
    const detail = root.querySelector<HTMLElement>('#result-detail')!;
    const $ = (id: string) =>
      root.querySelector<HTMLInputElement | HTMLSelectElement>('#' + id);
    const n = (id: string) => {
      const value = ($(id) as HTMLInputElement | undefined)?.value ?? '';
      return Number(value.replace(/,/g, '') || 0);
    };
    const fmt = (v: number, d = 0) =>
      Number.isFinite(v)
        ? v.toLocaleString('ko-KR', { maximumFractionDigits: d })
        : '-';
    const won = (v: number) => fmt(v) + '원';
    const stepFor = (id: string, suffix: string) => {
      if (id === 'rate') {
        return [
          'compound',
          'dsr',
          'rent',
          'brokerage',
          'leaseLoan',
          'property',
          'acquisition',
        ].includes(kind)
          ? '0.1'
          : '1';
      }
      if (id === 'loanRate') return '1';
      if (id === 'cc') return '100';
      if (id === 'hourly') return '100';
      if (suffix === '원') {
        return [
          'principal',
          'price',
          'sale',
          'buy',
          'taxbase',
          'deposit',
          'income',
          'debt',
          'newdebt',
          'mortgage',
        ].includes(id)
          ? '100000'
          : '10000';
      }
      return '1';
    };
    const isDecimal = (id: string) => id === 'rate' || id === 'loanRate';
    const field = (
      id: string,
      label: string,
      value: string,
      type = 'number',
      suffix = '',
    ) => {
      if (type !== 'number') {
        return `<label><span class="cm-label">${label}</span><div relative><input class="cm-input" id="${id}" type="${type}" value="${value}" data-default-value="${value}" />${suffix ? `<span absolute right-4 top="[50%]" translate-y="[-50%]" text="sm" text-text-muted dark="text-dark-text-muted">${suffix}</span>` : ''}</div></label>`;
      }
      const step = stepFor(id, suffix);
      const decimal = isDecimal(id);
      const paddingRight = suffix === '원' ? 'pr-12' : suffix ? 'pr-14' : '';
      return `<label><span class="cm-label">${label}</span><div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button type="button" data-step-direction="-1" aria-label="${label} 감소" class="cm-step-button">−</button>
        <div relative><input class="cm-input ${paddingRight}" id="${id}" type="text" inputmode="${decimal ? 'decimal' : 'numeric'}" value="${value}" data-default-value="${value}" data-number-input data-step="${step}" data-min="0" data-decimal="${decimal}" />${suffix ? `<span absolute right-4 top="[50%]" translate-y="[-50%]" text="sm" text-text-muted dark="text-dark-text-muted">${suffix}</span>` : ''}</div>
        <button type="button" data-step-direction="1" aria-label="${label} 증가" class="cm-step-button">+</button>
      </div></label>`;
    };
    const select = (id: string, label: string, options: string[]) =>
      `<label><span class="cm-label">${label}</span><select class="cm-input" id="${id}">${options.map((x) => `<option value="${x}">${x}</option>`).join('')}</select></label>`;

    const configs: Record<string, () => string> = {
      compound: () =>
        field('principal', '초기금액', '10000000', 'number', '원') +
        field('rate', '연이율', '3.5', 'number', '%') +
        field('years', '기간', '10', 'number', '년') +
        field('deposit', '정기 추가납입', '0', 'number', '원'),
      dsr: () =>
        field('income', '연소득', '50000000', 'number', '원') +
        field('debt', '연간 원리금 상환액', '12000000', 'number', '원') +
        field('newdebt', '새 대출 연간 상환액', '6000000', 'number', '원') +
        field('rate', '목표 DSR', '40', 'number', '%'),
      dti: () =>
        field('income', '연소득', '50000000', 'number', '원') +
        field(
          'mortgage',
          '주택담보대출 연간 원리금',
          '12000000',
          'number',
          '원',
        ) +
        field('other', '기타 대출 연간 이자상환액', '3000000', 'number', '원'),
      severance: () =>
        field('monthly', '월 평균임금', '3500000', 'number', '원') +
        field('years', '근속연수', '5', 'number', '년') +
        field('days', '계속근로일수', '1825', 'number', '일'),
      weekly: () =>
        field('hourly', '시급', '12000', 'number', '원') +
        field('hours', '주 소정근로시간', '40', 'number', '시간'),
      vacation: () =>
        field('daily', '1일 통상임금', '100000', 'number', '원') +
        field('days', '미사용 연차', '10', 'number', '일'),
      unemployment: () =>
        field('daily', '1일 평균임금', '120000', 'number', '원') +
        field('days', '예상 지급일수', '180', 'number', '일'),
      vat: () =>
        field('supply', '공급가액', '1000000', 'number', '원') +
        select('type', '계산 방향', [
          '공급가액 → 부가세',
          '합계금액 → 공급가액',
        ]),
      incomeTax: () =>
        field('income', '연간 과세소득', '50000000', 'number', '원'),
      acquisition: () =>
        field('price', '취득가액', '500000000', 'number', '원') +
        field('rate', '취득세율', '1.0', 'number', '%'),
      property: () =>
        field('taxbase', '과세표준', '300000000', 'number', '원') +
        field('rate', '재산세율', '0.1', 'number', '%'),
      capitalGain: () =>
        field('sale', '양도가액', '700000000', 'number', '원') +
        field('buy', '취득가액', '500000000', 'number', '원') +
        field('cost', '필요경비', '10000000', 'number', '원') +
        field('rate', '가정 세율', '20', 'number', '%'),
      carTax: () =>
        field('cc', '배기량', '1998', 'number', 'cc') +
        field('rate', '가정 세율', '200', 'number', '원/cc'),
      rent: () =>
        field('deposit', '보증금', '10000000', 'number', '원') +
        field('monthly', '월세', '700000', 'number', '원') +
        field('rate', '전월세 전환율', '5.5', 'number', '%'),
      brokerage: () =>
        field('price', '거래금액', '500000000', 'number', '원') +
        field('rate', '중개보수율', '0.4', 'number', '%'),
      leaseLoan: () =>
        field('deposit', '임차보증금', '200000000', 'number', '원') +
        field('loanRate', '대출비율', '80', 'number', '%') +
        field('rate', '연이율', '3.5', 'number', '%'),
      percentage: () =>
        field('base', '기준값', '100000', 'number', '') +
        field('rate', '퍼센트', '15', 'number', '%'),
      monthlySalary: () =>
        field('annual', '연봉', '40000000', 'number', '원') +
        field('bonus', '연간 비과세·별도 금액', '0', 'number', '원'),
      hourlyWage: () =>
        field('monthly', '월 급여', '3333333', 'number', '원') +
        field('hours', '월 근로시간', '209', 'number', '시간'),
    };
    fields.innerHTML = (configs[kind] || configs.percentage)();

    bindNumberControls(fields);

    const calc = () => {
      let value = 0,
        text = '';
      switch (kind) {
        case 'compound': {
          const p = n('principal'),
            r = n('rate') / 100,
            y = n('years'),
            m = n('deposit'),
            final =
              r === 0
                ? p + m * y
                : p * (1 + r) ** y + (m * ((1 + r) ** y - 1)) / r;
          value = final;
          text = `원금과 추가납입을 연복리로 단순 계산한 결과입니다. 이자: ${won(final - p - m * y)}`;
          break;
        }
        case 'dsr': {
          const income = n('income'),
            total = n('debt') + n('newdebt'),
            dsr = (total / income) * 100;
          value = dsr;
          text = `현재 대출만 반영한 DSR: ${fmt((n('debt') / income) * 100, 2)}%. 새 대출 포함: ${fmt(dsr, 2)}%. 입력한 목표 기준: ${fmt(n('rate'), 2)}%.`;
          break;
        }
        case 'dti': {
          const income = n('income'),
            ratio = ((n('mortgage') + n('other')) / income) * 100;
          value = ratio;
          text = `주택담보대출 원리금과 기타 대출 이자 합계를 연소득으로 나눈 단순 DTI입니다.`;
          break;
        }
        case 'severance': {
          value = n('monthly') * n('years');
          text = `월 평균임금 × 근속연수로 단순 추정했습니다. 실제 퇴직금은 평균임금 산정기간과 계속근로기간 등에 따라 달라질 수 있습니다.`;
          break;
        }
        case 'weekly': {
          const weeklyHoliday =
            n('hours') >= 15 ? n('hourly') * Math.min(8, n('hours')) : 0;
          value = n('hourly') * n('hours') + weeklyHoliday;
          text = `입력한 소정근로시간을 기준으로 주급과 주휴수당을 단순 합산했습니다.`;
          break;
        }
        case 'vacation': {
          value = n('daily') * n('days');
          text =
            '미사용 연차수당을 1일 통상임금 × 미사용 일수로 단순 계산했습니다.';
          break;
        }
        case 'unemployment': {
          value = n('daily') * 0.6 * n('days');
          text =
            '구직급여의 하한·상한과 개인별 수급요건을 모두 반영한 확정액이 아닌 단순 예상값입니다.';
          break;
        }
        case 'monthlySalary': {
          value = (n('annual') - n('bonus')) / 12;
          text =
            '연봉에서 입력한 연간 별도 금액을 제외한 금액을 12개월로 나눈 단순 월 급여입니다.';
          break;
        }
        case 'hourlyWage': {
          value = n('hours') > 0 ? n('monthly') / n('hours') : 0;
          text = '월 급여를 월 근로시간으로 나눈 단순 시급입니다.';
          break;
        }
        case 'vat': {
          if ($('type')?.value === '공급가액 → 부가세') {
            value = n('supply') * 0.1;
            text = `부가세: ${won(value)} · 합계: ${won(n('supply') + value)}`;
          } else {
            const total = n('supply');
            value = total / 11;
            text = `공급가액: ${won(total - value)} · 부가세: ${won(value)}`;
          }
          break;
        }
        case 'incomeTax': {
          const income = n('income');
          let tax = 0;
          if (income <= 14000000) tax = income * 0.06;
          else if (income <= 50000000) tax = income * 0.15 - 1260000;
          else if (income <= 88000000) tax = income * 0.24 - 5760000;
          else if (income <= 150000000) tax = income * 0.35 - 15440000;
          else if (income <= 300000000) tax = income * 0.38 - 19940000;
          else tax = income * 0.4 - 25940000;
          value = Math.max(0, tax);
          text =
            '과세표준 구간별 세율을 단순 적용한 소득세 예상값입니다. 각종 공제와 세액공제는 반영하지 않았습니다.';
          break;
        }
        case 'acquisition': {
          value = (n('price') * n('rate')) / 100;
          text =
            '입력한 취득가액과 세율만 적용한 취득세 단순 예상값입니다. 지방교육세·농어촌특별세 등 부가세목은 제외했습니다.';
          break;
        }
        case 'property': {
          value = (n('taxbase') * n('rate')) / 100;
          text = '입력한 과세표준과 세율만 적용한 재산세 단순 예상값입니다.';
          break;
        }
        case 'capitalGain': {
          const gain = Math.max(0, n('sale') - n('buy') - n('cost'));
          value = (gain * n('rate')) / 100;
          text = `양도차익: ${won(gain)} · 입력한 가정 세율을 적용했습니다. 장기보유특별공제와 기본공제 등은 제외했습니다.`;
          break;
        }
        case 'carTax': {
          value = n('cc') * n('rate');
          text =
            '배기량 × 입력 세율로 계산한 단순 자동차세입니다. 실제 자동차세는 차종·차령·지방교육세 등에 따라 달라질 수 있습니다.';
          break;
        }
        case 'rent': {
          const annual = (n('deposit') * n('rate')) / 100;
          value = n('monthly') * 12 + annual;
          text = `연간 월세: ${won(n('monthly') * 12)} · 보증금 환산액: ${won(annual)} · 합계: ${won(value)}`;
          break;
        }
        case 'brokerage': {
          value = (n('price') * n('rate')) / 100;
          text = `거래금액 × 입력 중개보수율입니다. 실제 법정 상한요율과 부가세 여부를 확인해야 합니다.`;
          break;
        }
        case 'leaseLoan': {
          const loan = (n('deposit') * n('loanRate')) / 100;
          value = (loan * n('rate')) / 100;
          text = `예상 대출금: ${won(loan)} · 1년 단순 이자: ${won(value)}`;
          break;
        }
        default: {
          value = (n('base') * n('rate')) / 100;
          text = `기준값의 ${fmt(n('rate'), 2)}% = ${won(value)}`;
        }
      }
      out.textContent =
        kind === 'dsr' || kind === 'dti' || (kind === 'capitalGain' && false)
          ? fmt(value, 2) + '%'
          : kind === 'capitalGain'
            ? won(value)
            : kind === 'compound' ||
                kind === 'severance' ||
                kind === 'weekly' ||
                kind === 'vacation' ||
                kind === 'unemployment' ||
                kind === 'vat' ||
                kind === 'incomeTax' ||
                kind === 'acquisition' ||
                kind === 'property' ||
                kind === 'carTax' ||
                kind === 'rent' ||
                kind === 'brokerage' ||
                kind === 'leaseLoan' ||
                kind === 'percentage' ||
                kind === 'monthlySalary' ||
                kind === 'hourlyWage'
              ? won(value)
              : fmt(value, 2) + '%';
      if (kind === 'dsr' || kind === 'dti')
        out.textContent = fmt(value, 2) + '%';
      detail.textContent = text;
    };
    const reset = () => {
      fields.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
        const defaultValue = input.dataset.defaultValue;
        if (defaultValue !== undefined) {
          input.value = defaultValue;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      });
      fields.querySelectorAll<HTMLSelectElement>('select').forEach((select) => {
        select.selectedIndex = 0;
      });
      calc();
    };
    root.querySelector('#calculate')?.addEventListener('click', calc);
    root.querySelector('#reset')?.addEventListener('click', reset);
    fields.addEventListener('input', () => {
      if (kind === 'unit' || kind === 'percentage') calc();
    });
    fields.addEventListener('change', calc);
    calc();
  }
</script>
