---
---

<div data-calculator="dti">
  <div id="fields" grid="~ cols-1 md:cols-2" gap="4">
    <label>
      <span class="cm-label">연소득</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button type="button" data-step-direction="-1" aria-label="연소득 감소" class="cm-step-button">−</button>
        <div relative>
          <input class="cm-input pr-12" id="income" type="text" inputmode="numeric" value="50000000" data-default-value="50000000" data-number-input data-step="100000" data-min="0" data-decimal="false" />
          <span absolute right-4 top="[50%]" translate-y="[-50%]" text="sm" text-text-muted dark="text-dark-text-muted">원</span>
        </div>
        <button type="button" data-step-direction="1" aria-label="연소득 증가" class="cm-step-button">+</button>
      </div>
    </label>
    <label>
      <span class="cm-label">주택담보대출 금액</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button type="button" data-step-direction="-1" aria-label="주택담보대출 금액 감소" class="cm-step-button">−</button>
        <div relative>
          <input class="cm-input pr-12" id="mortgageAmount" type="text" inputmode="numeric" value="300000000" data-default-value="300000000" data-number-input data-step="100000" data-min="0" data-decimal="false" />
          <span absolute right-4 top="[50%]" translate-y="[-50%]" text="sm" text-text-muted dark="text-dark-text-muted">원</span>
        </div>
        <button type="button" data-step-direction="1" aria-label="주택담보대출 금액 증가" class="cm-step-button">+</button>
      </div>
    </label>
    <label>
      <span class="cm-label">주택담보대출 금리</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button type="button" data-step-direction="-1" aria-label="주택담보대출 금리 감소" class="cm-step-button">−</button>
        <div relative>
          <input class="cm-input pr-14" id="mortgageRate" type="text" inputmode="decimal" value="4.0" data-default-value="4.0" data-number-input data-step="0.1" data-min="0" data-decimal="true" />
          <span absolute right-4 top="[50%]" translate-y="[-50%]" text="sm" text-text-muted dark="text-dark-text-muted">%</span>
        </div>
        <button type="button" data-step-direction="1" aria-label="주택담보대출 금리 증가" class="cm-step-button">+</button>
      </div>
    </label>
    <label>
      <span class="cm-label">주택담보대출 기간</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button type="button" data-step-direction="-1" aria-label="주택담보대출 기간 감소" class="cm-step-button">−</button>
        <div relative>
          <input class="cm-input pr-14" id="mortgageYears" type="text" inputmode="numeric" value="30" data-default-value="30" data-number-input data-step="1" data-min="0" data-decimal="false" />
          <span absolute right-4 top="[50%]" translate-y="[-50%]" text="sm" text-text-muted dark="text-dark-text-muted">년</span>
        </div>
        <button type="button" data-step-direction="1" aria-label="주택담보대출 기간 증가" class="cm-step-button">+</button>
      </div>
    </label>
    <label>
      <span class="cm-label">주택담보대출 상환방식</span>
      <select class="cm-input" id="mortgageMethod">
        <option value="원리금균등">원리금균등</option>
        <option value="원금균등">원금균등</option>
        <option value="만기일시">만기일시</option>
      </select>
    </label>
    <label>
      <span class="cm-label">기타 대출 금액</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button type="button" data-step-direction="-1" aria-label="기타 대출 금액 감소" class="cm-step-button">−</button>
        <div relative>
          <input class="cm-input pr-12" id="otherDebt" type="text" inputmode="numeric" value="50000000" data-default-value="50000000" data-number-input data-step="100000" data-min="0" data-decimal="false" />
          <span absolute right-4 top="[50%]" translate-y="[-50%]" text="sm" text-text-muted dark="text-dark-text-muted">원</span>
        </div>
        <button type="button" data-step-direction="1" aria-label="기타 대출 금액 증가" class="cm-step-button">+</button>
      </div>
    </label>
    <label>
      <span class="cm-label">기타 대출 금리</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button type="button" data-step-direction="-1" aria-label="기타 대출 금리 감소" class="cm-step-button">−</button>
        <div relative>
          <input class="cm-input pr-14" id="otherRate" type="text" inputmode="decimal" value="5.0" data-default-value="5.0" data-number-input data-step="0.1" data-min="0" data-decimal="true" />
          <span absolute right-4 top="[50%]" translate-y="[-50%]" text="sm" text-text-muted dark="text-dark-text-muted">%</span>
        </div>
        <button type="button" data-step-direction="1" aria-label="기타 대출 금리 증가" class="cm-step-button">+</button>
      </div>
    </label>
    <label>
      <span class="cm-label">목표 DTI</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button type="button" data-step-direction="-1" aria-label="목표 DTI 감소" class="cm-step-button">−</button>
        <div relative>
          <input class="cm-input pr-14" id="rate" type="text" inputmode="decimal" value="40" data-default-value="40" data-number-input data-step="0.1" data-min="0" data-decimal="true" />
          <span absolute right-4 top="[50%]" translate-y="[-50%]" text="sm" text-text-muted dark="text-dark-text-muted">%</span>
        </div>
        <button type="button" data-step-direction="1" aria-label="목표 DTI 증가" class="cm-step-button">+</button>
      </div>
    </label>
  </div>
  <div id="result" mt="5" rounded="2xl" bg="primary/10" p="5" dark="bg-dark-primary-surface">
    <p m="0" text="sm" text-text-muted dark="text-dark-text-muted">계산 결과</p>
    <div id="result-value" mt="2" text="2xl md:3xl" font="800" text-primary>-</div>
    <div id="result-detail" mt="3" text="sm" leading="7" text-text-muted dark="text-dark-text-muted"></div>
  </div>
  <div grid="~ cols-1 sm:cols-2" gap="3" mt="5">
    <button id="calculate" class="cm-button-primary" py="3">계산하기</button>
    <button id="reset" class="cm-button-secondary" py="3">초기화</button>
  </div>
</div>

<script>
  import { bindNumberControls } from '../../lib/calculators/number-input';
  import { calculateDti, type DtiRepaymentMethod } from '../../lib/calculators/dti';

  const root = document.querySelector<HTMLElement>('[data-calculator="dti"]');
  if (root) {
    const fields = root.querySelector<HTMLElement>('#fields')!;
    const out = root.querySelector<HTMLElement>('#result-value')!;
    const detail = root.querySelector<HTMLElement>('#result-detail')!;
    const $ = (id: string) =>
      root.querySelector<HTMLInputElement | HTMLSelectElement>('#' + id);
    const n = (id: string) => {
      const value = ($(id) as HTMLInputElement | undefined)?.value ?? '';
      return Number(value.replace(/,/g, '') || 0);
    };
    const fmt = (v: number, d = 0) =>
      Number.isFinite(v)
        ? v.toLocaleString('ko-KR', { maximumFractionDigits: d })
        : '-';
    const won = (v: number) => fmt(v) + '원';

    bindNumberControls(fields);

    const calc = () => {
      const methodMap: Record<string, DtiRepaymentMethod> = {
        원리금균등: 'equalPayment',
        원금균등: 'equalPrincipal',
        만기일시: 'maturity',
      };
      const methodLabel = $('mortgageMethod')?.value ?? '원리금균등';
      const result = calculateDti({
        annualIncome: n('income'),
        mortgageAmount: n('mortgageAmount'),
        mortgageRate: n('mortgageRate'),
        mortgageYears: n('mortgageYears'),
        mortgageMethod: methodMap[methodLabel] ?? 'equalPayment',
        otherDebtAmount: n('otherDebt'),
        otherDebtRate: n('otherRate'),
        targetDti: n('rate'),
      });
      out.textContent = fmt(result.dti, 2) + '%';
      const status = result.withinTarget
        ? `목표 DTI ${fmt(n('rate'), 2)}% 이내`
        : `목표 DTI ${fmt(n('rate'), 2)}% 초과`;
      detail.textContent =
        `주택담보대출 연간 원리금: ${won(result.annualMortgagePayment)} · 기타 대출 연간 이자: ${won(result.annualOtherInterest)} · 연간 상환부담: ${won(result.annualDebtService)} · 상환방식: ${methodLabel} · ${status} · 목표 DTI 기준 연간 여유액: ${won(result.headroom)}`;
    };

    const reset = () => {
      fields.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
        const defaultValue = input.dataset.defaultValue;
        if (defaultValue !== undefined) {
          input.value = defaultValue;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      });
      fields.querySelectorAll<HTMLSelectElement>('select').forEach((select) => {
        select.selectedIndex = 0;
      });
      calc();
    };

    root.querySelector('#calculate')?.addEventListener('click', calc);
    root.querySelector('#reset')?.addEventListener('click', reset);
    fields.addEventListener('change', calc);
    calc();
  }
</script>
