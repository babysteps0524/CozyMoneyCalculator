---
---

<div data-calculator="compound">
  <div id="fields" grid="~ cols-1 md:cols-2" gap="4">
    <label class="cm-field">
      <span class="cm-label">초기금액</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="초기금액 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input pr-12"
            id="principal"
            type="text"
            inputmode="numeric"
            value="10000000"
            data-default-value="10000000"
            data-number-input
            data-step="100000"
            data-min="0"
            data-decimal="false"
          />
          <span
            absolute
            right-4
            top="[50%]"
            translate-y="[-50%]"
            text="sm"
            text-text-muted
            dark="text-dark-text-muted"
          >
            원
          </span>
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="초기금액 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </label>
    <label class="cm-field">
      <span class="cm-label">연이율</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="연이율 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input pr-14"
            id="rate"
            type="text"
            inputmode="decimal"
            value="3.5"
            data-default-value="3.5"
            data-number-input
            data-step="0.1"
            data-min="0"
            data-decimal="true"
          />
          <span
            absolute
            right-4
            top="[50%]"
            translate-y="[-50%]"
            text="sm"
            text-text-muted
            dark="text-dark-text-muted"
          >
            %
          </span>
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="연이율 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </label>
    <label class="cm-field">
      <span class="cm-label">기간</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="기간 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input pr-14"
            id="years"
            type="text"
            inputmode="numeric"
            value="10"
            data-default-value="10"
            data-number-input
            data-step="1"
            data-min="0"
            data-decimal="false"
          />
          <span
            absolute
            right-4
            top="[50%]"
            translate-y="[-50%]"
            text="sm"
            text-text-muted
            dark="text-dark-text-muted"
          >
            년
          </span>
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="기간 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </label>
    <label class="cm-field">
      <span class="cm-label">정기 추가납입</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="정기 추가납입 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input pr-12"
            id="deposit"
            type="text"
            inputmode="numeric"
            value="0"
            data-default-value="0"
            data-number-input
            data-step="10000"
            data-min="0"
            data-decimal="false"
          />
          <span
            absolute
            right-4
            top="[50%]"
            translate-y="[-50%]"
            text="sm"
            text-text-muted
            dark="text-dark-text-muted"
          >
            원
          </span>
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="정기 추가납입 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </label>
  </div>
  <div
    id="result"
    mt="5"
    rounded="2xl"
    bg="primary/10"
    p="5"
    dark="bg-dark-primary-surface"
  >
    <p class="cm-help-text" text="sm">
      계산 결과
    </p>
    <div id="result-value" mt="2" text="2xl md:3xl" font="800" text-primary>
      -
    </div>
    <div id="result-detail" class="cm-help-text" mt="3"></div>
  </div>
  <div grid="~ cols-1 sm:cols-2" gap="3" mt="5">
    <button id="calculate" class="cm-button-primary" py="3">
      계산하기
    </button>
    <button id="reset" class="cm-button-secondary" py="3">
      초기화
    </button>
  </div>
</div>

<script>
  import { bindNumberControls } from '../../lib/calculators/number-input';
  import { bindLiveCalculation } from '../../lib/calculators/runtime';

  const root = document.querySelector<HTMLElement>(
    '[data-calculator="compound"]',
  );
  if (root) {
    const fields = root.querySelector<HTMLElement>('#fields')!;
    const out = root.querySelector<HTMLElement>('#result-value')!;
    const detail = root.querySelector<HTMLElement>('#result-detail')!;
    const $ = (id: string) =>
      root.querySelector<HTMLInputElement | HTMLSelectElement>('#' + id);
    const n = (id: string) => {
      const value = ($(id) as HTMLInputElement | undefined)?.value ?? '';
      return Number(value.replace(/,/g, '') || 0);
    };
    const fmt = (v: number, d = 0) =>
      Number.isFinite(v)
        ? v.toLocaleString('ko-KR', { maximumFractionDigits: d })
        : '-';
    const won = (v: number) => fmt(v) + '원';

    bindNumberControls(fields);

    const calc = () => {
      const p = n('principal');
      const r = n('rate') / 100;
      const y = n('years');
      const m = n('deposit');
      const final =
        r === 0 ? p + m * y : p * (1 + r) ** y + (m * ((1 + r) ** y - 1)) / r;
      out.textContent = won(final);
      detail.textContent = `원금과 추가납입을 연복리로 단순 계산한 결과입니다. 이자: ${won(final - p - m * y)}`;
    };

    const reset = () => {
      fields.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
        const defaultValue = input.dataset.defaultValue;
        if (defaultValue !== undefined) {
          input.value = defaultValue;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      });
      fields.querySelectorAll<HTMLSelectElement>('select').forEach((select) => {
        select.selectedIndex = 0;
      });
      calc();
    };

    root.querySelector('#calculate')?.addEventListener('click', calc);
    root.querySelector('#reset')?.addEventListener('click', reset);
    bindLiveCalculation(fields, calc);
    calc();
  }
</script>
