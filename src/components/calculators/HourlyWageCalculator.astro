---
---

<div data-calculator="hourlyWage">
  <div id="fields" grid="~ cols-1 md:cols-2" gap="4">
    <label class="cm-field">
      <span class="cm-label">급여 형태</span>
      <select class="cm-input" id="payType">
        <option value="시급">시급</option>
        <option value="일급">일급</option>
        <option value="주급">주급</option>
        <option value="월급">월급</option>
        <option value="연봉">연봉</option>
      </select>
    </label>
    <label class="cm-field">
      <span class="cm-label">급여 금액</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="급여 금액 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input pr-12"
            id="amount"
            type="text"
            inputmode="numeric"
            value="10320"
            data-default-value="10320"
            data-number-input
            data-step="100"
            data-min="0"
            data-decimal="false"
          />
          <span
            absolute
            right-4
            top="[50%]"
            translate-y="[-50%]"
            text="sm"
            text-text-muted
            dark="text-dark-text-muted"
          >
            원
          </span>
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="급여 금액 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </label>
    <label class="cm-field">
      <span class="cm-label">일일 근무시간</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="일일 근무시간 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input pr-14"
            id="dailyHours"
            type="text"
            inputmode="numeric"
            value="8"
            data-default-value="8"
            data-number-input
            data-step="1"
            data-min="0"
            data-decimal="false"
          />
          <span
            absolute
            right-4
            top="[50%]"
            translate-y="[-50%]"
            text="sm"
            text-text-muted
            dark="text-dark-text-muted"
          >
            시간
          </span>
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="일일 근무시간 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </label>
    <label class="cm-field">
      <span class="cm-label">일주 근무일수</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="일주 근무일수 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input pr-14"
            id="weeklyDays"
            type="text"
            inputmode="numeric"
            value="5"
            data-default-value="5"
            data-number-input
            data-step="1"
            data-min="0"
            data-decimal="false"
          />
          <span
            absolute
            right-4
            top="[50%]"
            translate-y="[-50%]"
            text="sm"
            text-text-muted
            dark="text-dark-text-muted"
          >
            일
          </span>
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="일주 근무일수 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </label>
    <label class="cm-field">
      <span class="cm-label">한달 근무일수</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="한달 근무일수 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input pr-14"
            id="monthlyDays"
            type="text"
            inputmode="numeric"
            value="22"
            data-default-value="22"
            data-number-input
            data-step="1"
            data-min="0"
            data-decimal="false"
          />
          <span
            absolute
            right-4
            top="[50%]"
            translate-y="[-50%]"
            text="sm"
            text-text-muted
            dark="text-dark-text-muted"
          >
            일
          </span>
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="한달 근무일수 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </label>
    <label class="cm-field">
      <span class="cm-label">주 연장 근무시간</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="주 연장 근무시간 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input pr-14"
            id="weeklyOvertimeHours"
            type="text"
            inputmode="numeric"
            value="0"
            data-default-value="0"
            data-number-input
            data-step="1"
            data-min="0"
            data-decimal="false"
          />
          <span
            absolute
            right-4
            top="[50%]"
            translate-y="[-50%]"
            text="sm"
            text-text-muted
            dark="text-dark-text-muted"
          >
            시간
          </span>
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="주 연장 근무시간 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </label>
    <label class="cm-field">
      <span class="cm-label">월 연장 근무시간</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="월 연장 근무시간 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input pr-14"
            id="monthlyOvertimeHours"
            type="text"
            inputmode="numeric"
            value="0"
            data-default-value="0"
            data-number-input
            data-step="1"
            data-min="0"
            data-decimal="false"
          />
          <span
            absolute
            right-4
            top="[50%]"
            translate-y="[-50%]"
            text="sm"
            text-text-muted
            dark="text-dark-text-muted"
          >
            시간
          </span>
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="월 연장 근무시간 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </label>
    <label class="cm-field">
      <span class="cm-label">주휴수당</span>
      <select class="cm-input" id="weeklyHoliday">
        <option value="포함">포함</option>
        <option value="미포함">미포함</option>
      </select>
    </label>
    <label class="cm-field">
      <span class="cm-label">세금</span>
      <select class="cm-input" id="taxType">
        <option value="미적용">미적용</option>
        <option value="4대보험 9.7%">4대보험 9.7%</option>
        <option value="소득세 3.3%">소득세 3.3%</option>
      </select>
    </label>
    <label class="cm-field">
      <span class="cm-label">수습</span>
      <select class="cm-input" id="probation">
        <option value="미적용 · 전액 지급">미적용 · 전액 지급</option>
        <option value="적용 · 예상 급여액 10% 차감">
          적용 · 예상 급여액 10% 차감
        </option>
      </select>
    </label>
  </div>
  <div
    id="result"
    aria-live="polite"
    aria-atomic="true"
    mt="5"
    rounded="2xl"
    bg="primary/10"
    p="5"
    dark="bg-dark-primary-surface"
  >
    <p class="cm-help-text" text="sm">
      계산 결과
    </p>
    <div id="result-value" mt="2" text="2xl md:3xl" font="800" text-primary>
      -
    </div>
    <div id="result-detail" class="cm-help-text" mt="3"></div>
  </div>
  <div grid="~ cols-1 sm:cols-2" gap="3" mt="5">
    <button id="calculate" class="cm-button-primary" py="3">
      계산하기
    </button>
    <button id="reset" class="cm-button-secondary" py="3">
      초기화
    </button>
  </div>
</div>

<script>
  import { bindNumberControls } from '../../lib/calculators/number-input';
  import { bindLiveCalculation } from '../../lib/calculators/runtime';
  import {
    calculateHourlyWage,
    type HourlyPayType,
    type HourlyTaxType,
  } from '../../lib/calculators/hourlyWage';

  const root = document.querySelector<HTMLElement>(
    '[data-calculator="hourlyWage"]',
  );
  if (root) {
    const fields = root.querySelector<HTMLElement>('#fields')!;
    const out = root.querySelector<HTMLElement>('#result-value')!;
    const detail = root.querySelector<HTMLElement>('#result-detail')!;
    const $ = (id: string) =>
      root.querySelector<HTMLInputElement | HTMLSelectElement>('#' + id);
    const n = (id: string) => {
      const value = ($(id) as HTMLInputElement | undefined)?.value ?? '';
      return Number(value.replace(/,/g, '') || 0);
    };
    const fmt = (v: number, d = 0) =>
      Number.isFinite(v)
        ? v.toLocaleString('ko-KR', { maximumFractionDigits: d })
        : '-';
    const won = (v: number) => fmt(v) + '원';

    bindNumberControls(fields);

    const calc = () => {
      const payTypeMap: Record<string, HourlyPayType> = {
        시급: 'hourly',
        일급: 'daily',
        주급: 'weekly',
        월급: 'monthly',
        연봉: 'annual',
      };
      const taxTypeMap: Record<string, HourlyTaxType> = {
        미적용: 'none',
        '4대보험 9.7%': 'insurance',
        '소득세 3.3%': 'income',
      };
      const result = calculateHourlyWage({
        payType: payTypeMap[$('payType')?.value ?? '시급'] ?? 'hourly',
        amount: n('amount'),
        dailyHours: n('dailyHours'),
        weeklyDays: n('weeklyDays'),
        monthlyDays: n('monthlyDays'),
        weeklyOvertimeHours: n('weeklyOvertimeHours'),
        monthlyOvertimeHours: n('monthlyOvertimeHours'),
        weeklyHolidayIncluded: $('weeklyHoliday')?.value === '포함',
        taxType: taxTypeMap[$('taxType')?.value ?? '미적용'] ?? 'none',
        probation: ($('probation')?.value ?? '').startsWith('적용'),
      });

      out.textContent = won(result.netMonthlyWage);
      const minimumWageStatus =
        result.hourlyWage >= 10320
          ? '2026년 최저임금 이상'
          : '2026년 최저임금 미만';
      detail.textContent = `예상 시급: ${won(result.hourlyWage)} · 예상 일급: ${won(result.dailyWage)} · 예상 주급: ${won(result.weeklyWage)} · 기본 월급: ${won(result.monthlyBaseWage)} · 주휴수당: ${won(result.weeklyHolidayPay)} · 주 연장수당: ${won(result.weeklyOvertimePay)} · 월 연장수당: ${won(result.monthlyOvertimePay)} · 월 세전: ${won(result.grossMonthlyWage)} · 공제: ${won(result.tax)} · 월 최종 환산금액: ${won(result.netMonthlyWage)} · ${minimumWageStatus}`;
    };

    const reset = () => {
      fields.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
        const defaultValue = input.dataset.defaultValue;
        if (defaultValue !== undefined) {
          input.value = defaultValue;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      });
      fields.querySelectorAll<HTMLSelectElement>('select').forEach((select) => {
        select.selectedIndex = 0;
      });
      calc();
    };

    root.querySelector('#calculate')?.addEventListener('click', calc);
    root.querySelector('#reset')?.addEventListener('click', reset);
    bindLiveCalculation(fields, calc, { change: true });
    calc();
  }
</script>
