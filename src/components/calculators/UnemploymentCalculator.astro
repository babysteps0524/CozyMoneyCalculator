---
---

<section class="cm-card" p="5 md:7" data-unemployment-calculator>
  <div>
    <p m="0" text="sm" font="700" text-primary>CALCULATOR</p>
    <h2 m="0" mt="1" text="xl md:2xl" font="800">구직급여 예상액 계산</h2>
    <p m="0" mt="2" text="sm" leading="6" text-text-muted dark="text-dark-text-muted">
      어려운 1일 평균임금을 직접 계산할 필요 없이 이직일과 직전 3개월 임금총액을 입력하면 자동으로 추정합니다.
    </p>
  </div>

  <div id="fields" grid="~ cols-1 md:cols-2" gap="4" mt="6">
    <label>
      <span class="cm-label">이직일</span>
      <input id="separation-date" class="cm-input" type="date" aria-describedby="date-help" />
      <span id="date-help" block mt="2" text="xs" leading="6" text-text-subtle dark="text-dark-text-subtle">
        마지막 근무일 다음 날이 아니라 실제 고용관계가 종료된 이직일을 기준으로 입력하세요.
      </span>
    </label>

    <label>
      <span class="cm-label">이직 전 3개월 임금총액</span>
      <div relative>
        <input id="wages" class="cm-input pr-12" type="text" inputmode="numeric" value="9,000,000" data-number-input data-step="10000" data-min="1" data-decimal="false" />
        <span absolute right-4 top="[50%]" translate-y="[-50%]" text="sm" text-text-muted dark="text-dark-text-muted">원</span>
      </div>
      <span block mt="2" text="xs" leading="6" text-text-subtle dark="text-dark-text-subtle">
        이직일 이전 3개월 동안의 임금총액을 입력하세요. 급여명세서의 실제 지급 임금을 기준으로 확인하는 것이 좋습니다.
      </span>
    </label>

    <label>
      <span class="cm-label">1일 소정근로시간</span>
      <select id="hours" class="cm-input">
        <option value="8" selected>8시간</option>
        <option value="7">7시간</option>
        <option value="6">6시간</option>
        <option value="5">5시간</option>
        <option value="4">4시간</option>
        <option value="3">3시간</option>
        <option value="2">2시간</option>
        <option value="1">1시간</option>
      </select>
      <span block mt="2" text="xs" leading="6" text-text-subtle dark="text-dark-text-subtle">
        구직급여 하한액 계산에 사용합니다.
      </span>
    </label>

    <label>
      <span class="cm-label">이직 당시 연령 구분</span>
      <select id="age" class="cm-input">
        <option value="under50" selected>50세 미만</option>
        <option value="over50OrDisabled">50세 이상 또는 장애인</option>
      </select>
    </label>

    <label>
      <span class="cm-label">고용보험 가입기간</span>
      <select id="period" class="cm-input">
        <option value="under1" selected>1년 미만</option>
        <option value="1to3">1년 이상 ~ 3년 미만</option>
        <option value="3to5">3년 이상 ~ 5년 미만</option>
        <option value="5to10">5년 이상 ~ 10년 미만</option>
        <option value="10plus">10년 이상</option>
      </select>
    </label>
  </div>

  <div mt="5" rounded="xl" bg="surface-muted" p="4" dark="bg-dark-surface-muted">
    <p m="0" text="sm" font="750">1일 평균임금은 자동으로 계산됩니다</p>
    <p m="0" mt="2" text="xs sm" leading="6" text-text-muted dark="text-dark-text-muted">
      계산기는 이직일 직전 3개월의 임금총액을 해당 기간의 총일수로 나누어 1일 평균임금을 추정합니다.
      실제 산정에서는 제외기간·제외임금 등이 반영될 수 있어 고용센터의 최종 산정액과 차이가 날 수 있습니다.
    </p>
  </div>

  <div grid="~ cols-1 sm:cols-2" gap="3" mt="6">
    <button id="calculate" type="button" class="cm-button-primary" py="3.5">계산하기</button>
    <button id="reset" type="button" class="cm-button-secondary" py="3.5">초기화</button>
  </div>

  <p id="error" hidden m="0" mt="4" rounded="xl" bg="danger-surface" px="4" py="3" text="sm" text="danger-text"></p>

  <section mt="6" rounded="2xl" bg="primary/10" p="5" dark="bg-dark-primary-surface">
    <p m="0" text="sm" text-text-muted dark="text-dark-text-muted">총 예상 구직급여</p>
    <strong id="total" block mt="2" text="2xl md:3xl" font="800" text-primary>-</strong>
    <p id="headline" m="0" mt="2" text="sm" leading="6" text-text-muted dark="text-dark-text-muted">-</p>
  </section>

  <div grid="~ cols-2 md:cols-3" gap="3" mt="3">
    <div class="cm-result"><p m="0" text="xs sm" text-text-muted dark="text-dark-text-muted">3개월 임금총액</p><strong id="wages-result" block mt="2">-</strong></div>
    <div class="cm-result"><p m="0" text="xs sm" text-text-muted dark="text-dark-text-muted">산정기간 총일수</p><strong id="period-days" block mt="2">-</strong></div>
    <div class="cm-result"><p m="0" text="xs sm" text-text-muted dark="text-dark-text-muted">1일 평균임금</p><strong id="average" block mt="2">-</strong></div>
    <div class="cm-result"><p m="0" text="xs sm" text-text-muted dark="text-dark-text-muted">60% 산정액</p><strong id="base" block mt="2">-</strong></div>
    <div class="cm-result"><p m="0" text="xs sm" text-text-muted dark="text-dark-text-muted">최종 1일 구직급여</p><strong id="daily-benefit" block mt="2">-</strong></div>
    <div class="cm-result"><p m="0" text="xs sm" text-text-muted dark="text-dark-text-muted">소정급여일수</p><strong id="days" block mt="2">-</strong></div>
  </div>

  <div mt="4" rounded="xl" border="1" border-border p="4" dark="border-dark-border">
    <p m="0" text="sm" font="750">계산 결과 해석</p>
    <p id="status" m="0" mt="2" text="sm" leading="7" text-text-muted dark="text-dark-text-muted">-</p>
  </div>

  <p m="0" mt="4" text="xs" leading="6" text-text-subtle dark="text-dark-text-subtle">
    이 계산기는 수급자격을 판정하지 않으며, 실제 지급액은 이직일·피보험기간·이직사유·근로시간·고용센터의 수급자격 인정 결과 등에 따라 달라질 수 있습니다.
  </p>
</section>

<script>
  import { bindNumberControls } from '../../lib/calculators/number-input';
  import {
    calculateEstimatedDailyAverageWage,
    calculateUnemployment,
  } from '../../lib/calculators/unemployment';

  const root = document.querySelector<HTMLElement>('[data-unemployment-calculator]');

  if (root) {
    const separationDate = root.querySelector<HTMLInputElement>('#separation-date')!;
    const wages = root.querySelector<HTMLInputElement>('#wages')!;
    const hours = root.querySelector<HTMLSelectElement>('#hours')!;
    const age = root.querySelector<HTMLSelectElement>('#age')!;
    const period = root.querySelector<HTMLSelectElement>('#period')!;
    const error = root.querySelector<HTMLElement>('#error')!;

    const fmt = (value: number) => Math.round(value).toLocaleString('ko-KR') + '원';
    const getWages = () => Number(wages.value.replace(/,/g, '') || 0);

    const getToday = () => {
      const today = new Date();
      const year = today.getFullYear();
      const month = String(today.getMonth() + 1).padStart(2, '0');
      const day = String(today.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };

    const calc = () => {
      try {
        error.hidden = true;

        const estimated = calculateEstimatedDailyAverageWage(getWages(), separationDate.value);
        const result = calculateUnemployment({
          dailyAverageWage: estimated.dailyAverageWage,
          dailyWorkingHours: Number(hours.value),
          ageGroup: age.value as 'under50' | 'over50OrDisabled',
          insurancePeriod: period.value as 'under1' | '1to3' | '3to5' | '5to10' | '10plus',
        });

        root.querySelector<HTMLElement>('#total')!.textContent = fmt(result.totalBenefit);
        root.querySelector<HTMLElement>('#headline')!.textContent =
          `1일 ${fmt(result.dailyBenefit)} × ${result.benefitDays}일`;
        root.querySelector<HTMLElement>('#wages-result')!.textContent = fmt(getWages());
        root.querySelector<HTMLElement>('#period-days')!.textContent = `${estimated.periodDays}일`;
        root.querySelector<HTMLElement>('#average')!.textContent = fmt(result.dailyAverageWage);
        root.querySelector<HTMLElement>('#base')!.textContent = fmt(result.baseBenefit);
        root.querySelector<HTMLElement>('#daily-benefit')!.textContent = fmt(result.dailyBenefit);
        root.querySelector<HTMLElement>('#days')!.textContent = `${result.benefitDays}일`;

        const status = result.lowerLimitApplied
          ? '1일 평균임금의 60%가 하한액보다 낮아 하한액을 적용했습니다.'
          : result.upperLimitApplied
            ? '1일 평균임금의 60%가 상한액보다 높아 상한액을 적용했습니다.'
            : '1일 평균임금의 60%가 상·하한 범위 안에 있어 그대로 적용했습니다.';

        root.querySelector<HTMLElement>('#status')!.textContent = status;
      } catch (e) {
        error.textContent = e instanceof Error ? e.message : '계산 중 오류가 발생했습니다.';
        error.hidden = false;
      }
    };

    root.querySelector('#calculate')?.addEventListener('click', calc);

    root.querySelector('#reset')?.addEventListener('click', () => {
      separationDate.value = getToday();
      wages.value = '9,000,000';
      hours.value = '8';
      age.value = 'under50';
      period.value = 'under1';
      calc();
    });

    separationDate.value = getToday();
    bindNumberControls(root);
    root.addEventListener('input', calc);
    root.addEventListener('change', calc);
    calc();
  }
</script>
