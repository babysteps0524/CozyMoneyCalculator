---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../common/Header.astro';
import Footer from '../common/Footer.astro';
import CalculatorShell from './CalculatorShell.astro';
import CalculatorContent from './CalculatorContent.astro';
import type { CalculatorGuidance } from '../../lib/calculators/guidance';

type Props =
  | {
      mode: 'custom';
      title: string;
      description: string;
      canonical: string;
      category?: never;
      guidance?: never;
    }
  | {
      mode?: 'standard';
      title: string;
      description: string;
      canonical: string;
      category: string;
      guidance: CalculatorGuidance;
    };

const {
  title,
  description,
  canonical,
  category = '',
  guidance,
  mode = 'standard',
} = Astro.props;

const isCustom = mode === 'custom';
const pageTitle = isCustom ? title : `${title} | CozyMoney 코지머니`;
---

<BaseLayout title={pageTitle} description={description} canonical={canonical}>
  <Header />
  {isCustom ? (
    <CalculatorShell mode="custom">
      <slot />
    </CalculatorShell>
  ) : (
    <main class="cm-container" w="full" py="10 md:14 lg:18">
      <nav
        aria-label="사이트 경로"
        mb="5"
        text="xs sm:sm"
        text-text-muted
        dark="text-dark-text-muted"
      >
        <a href="/" no-underline hover="text-primary">
          홈
        </a>
        <span mx="2">/</span>
        <a href="/calculators/" no-underline hover="text-primary">
          계산기
        </a>
        <span mx="2">/</span>
        <span>{category}</span>
      </nav>

      <header max-w="3xl" mb="8" aria-labelledby="calculator-page-title">
        <p m="0" text="sm" font="700" text-primary>
          {category}
        </p>
        <h1
          id="calculator-page-title"
          m="0"
          mt="2"
          text="3xl md:4xl"
          font="800"
          tracking-tight
        >
          {title}
        </h1>
        <p
          m="0"
          mt="4"
          text="base md:lg"
          leading="7"
          text-text-muted
          dark="text-dark-text-muted"
        >
          {description}
        </p>
      </header>

      <div w="full" max-w="4xl">
        <CalculatorShell title={title} description={description}>
          <slot />
        </CalculatorShell>

        {guidance ? <CalculatorContent guidance={guidance} /> : null}
      </div>

      <slot name="after" />
    </main>
  )}
  <Footer />
</BaseLayout>
