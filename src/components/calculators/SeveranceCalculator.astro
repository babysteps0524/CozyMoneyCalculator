---
---

  <div grid="~ cols-1 md:cols-2" gap="4">
    <label>
      <span class="cm-label">입사일</span>
      <input
        id="severance-start"
        class="cm-input"
        type="date"
        value="2021-10-01"
      />
    </label>
    <label>
      <span class="cm-label">퇴직일</span>
      <input
        id="severance-retirement"
        class="cm-input"
        type="date"
        value="2026-10-01"
      />
      <span
        mt="1.5"
        block
        text="xs"
        leading="5"
        text-text-muted
        dark="text-dark-text-muted"
      >
        마지막 근무일의 다음 날을 입력하세요.
      </span>
    </label>
  </div>

  <div mt="5">
    <h3 m="0" text="base" font="800">
      퇴직 전 3개월 임금
    </h3>
    <p
      id="severance-period"
      m="0"
      mt="1"
      text="xs"
      text-text-muted
      dark="text-dark-text-muted"
    >
      퇴직일을 입력하면 산정기간이 표시됩니다.
    </p>
    <div id="severance-months" grid="~ cols-1 md:cols-2" gap="4" mt="3"></div>
    <p
      m="0"
      mt="2"
      text="xs"
      leading="5"
      text-text-muted
      dark="text-dark-text-muted"
    >
      세전 임금 합계입니다. 기본급과 임금에 해당하는 수당 등 실제 지급액을
      합산하세요.
    </p>
  </div>

  <div grid="~ cols-1 md:cols-2" gap="4" mt="5">
    <label>
      <span class="cm-label">최근 1년 상여금 총액</span>
      <div relative>
        <input
          id="severance-bonus"
          class="cm-input pr-12"
          type="text"
          inputmode="numeric"
          value="0"
          data-number-input
          data-step="10000"
          data-min="0"
          data-decimal="false"
        />
        <span
          absolute
          right="4"
          top="[50%]"
          translate-y="[-50%]"
          text="sm"
          text-text-muted
          dark="text-dark-text-muted"
        >
          원
        </span>
      </div>
      <span
        mt="1.5"
        block
        text="xs"
        leading="5"
        text-text-muted
        dark="text-dark-text-muted"
      >
        평균임금 산입 대상 금액의 3/12만 반영합니다.
      </span>
    </label>
    <label>
      <span class="cm-label">최근 1년 연차수당</span>
      <div relative>
        <input
          id="severance-leave"
          class="cm-input pr-12"
          type="text"
          inputmode="numeric"
          value="0"
          data-number-input
          data-step="10000"
          data-min="0"
          data-decimal="false"
        />
        <span
          absolute
          right="4"
          top="[50%]"
          translate-y="[-50%]"
          text="sm"
          text-text-muted
          dark="text-dark-text-muted"
        >
          원
        </span>
      </div>
      <span
        mt="1.5"
        block
        text="xs"
        leading="5"
        text-text-muted
        dark="text-dark-text-muted"
      >
        이미 지급받은 산입 대상 연차수당을 입력하세요.
      </span>
    </label>
  </div>

  <div grid="~ cols-1 md:cols-2" gap="4" mt="5">
    <label>
      <span class="cm-label">
        1일 통상임금{' '}
        <span font="400" text-text-muted dark="text-dark-text-muted">
          (선택)
        </span>
      </span>
      <div relative>
        <input
          id="severance-ordinary"
          class="cm-input pr-12"
          type="text"
          inputmode="numeric"
          value="0"
          data-number-input
          data-step="1000"
          data-min="0"
          data-decimal="false"
        />
        <span
          absolute
          right="4"
          top="[50%]"
          translate-y="[-50%]"
          text="sm"
          text-text-muted
          dark="text-dark-text-muted"
        >
          원
        </span>
      </div>
      <span
        mt="1.5"
        block
        text="xs"
        leading="5"
        text-text-muted
        dark="text-dark-text-muted"
      >
        평균임금보다 높으면 더 높은 통상임금을 적용합니다.
      </span>
    </label>
    <label>
      <span class="cm-label">주 소정근로시간</span>
      <div relative>
        <input
          id="severance-hours"
          class="cm-input pr-14"
          type="text"
          inputmode="decimal"
          value="40"
          data-number-input
          data-step="1"
          data-min="0"
          data-decimal="true"
        />
        <span
          absolute
          right="4"
          top="[50%]"
          translate-y="[-50%]"
          text="sm"
          text-text-muted
          dark="text-dark-text-muted"
        >
          시간
        </span>
      </div>
      <span
        mt="1.5"
        block
        text="xs"
        leading="5"
        text-text-muted
        dark="text-dark-text-muted"
      >
        15시간 미만이면 퇴직금 대상에서 제외될 수 있습니다.
      </span>
    </label>
  </div>

  <details mt="5" rounded-xl border="1" border-border dark="border-dark-border">
    <summary cursor-pointer p="4" font="700" text-sm>
      평균임금 제외기간 고급 설정
    </summary>
    <div p="4" pt="0" grid="~ cols-1 md:cols-2" gap="4">
      <label>
        <span class="cm-label">제외일수</span>
        <div relative>
          <input
            id="severance-excluded-days"
            class="cm-input pr-12"
            type="text"
            inputmode="numeric"
            value="0"
            data-number-input
            data-step="1"
            data-min="0"
            data-decimal="false"
          />
          <span
            absolute
            right="4"
            top="[50%]"
            translate-y="[-50%]"
            text="sm"
            text-text-muted
            dark="text-dark-text-muted"
          >
            일
          </span>
        </div>
      </label>
      <label>
        <span class="cm-label">제외기간 임금</span>
        <div relative>
          <input
            id="severance-excluded-amount"
            class="cm-input pr-12"
            type="text"
            inputmode="numeric"
            value="0"
            data-number-input
            data-step="10000"
            data-min="0"
            data-decimal="false"
          />
          <span
            absolute
            right="4"
            top="[50%]"
            translate-y="[-50%]"
            text="sm"
            text-text-muted
            dark="text-dark-text-muted"
          >
            원
          </span>
        </div>
      </label>
      <p
        m="0"
        md="col-span-2"
        text="xs"
        leading="5"
        text-text-muted
        dark="text-dark-text-muted"
      >
        법정 평균임금 산정 제외기간에 해당하는 경우에만 사용하세요.
      </p>
    </div>
  </details>

  <div flex="~ col sm:row" gap="3" mt="6">
    <button
      id="severance-calculate"
      type="button"
      class="cm-button-primary"
      px="5"
      py="3"
    >
      퇴직금 계산하기
    </button>
    <button
      id="severance-reset"
      type="button"
      class="cm-button-secondary"
      px="5"
      py="3"
    >
      초기화
    </button>
  </div>

  <div
    id="severance-error"
    hidden
    mt="4"
    rounded="xl"
    border="1"
    border="danger/30"
    bg="danger-surface"
    p="4"
    text="sm"
    text="danger-text"
    dark="border-dark-danger-text/30 bg-dark-danger-surface text-dark-danger-text"
  ></div>

  <section
    mt="6"
    rounded-2xl
    border="1"
    border-border
    bg-surface-muted
    p="5"
    dark="border-dark-border bg-dark-surface-subtle"
    aria-live="polite"
  >
    <p m="0" text="sm" font="700" text-primary>
      예상 퇴직금 · 세전
    </p>
    <p
      id="severance-value"
      m="1 0 0"
      text="3xl md:4xl"
      font="800"
      tracking-tight
    >
      0원
    </p>
    <div
      id="severance-eligibility"
      mt="3"
      inline-flex
      rounded-full
      bg-surface
      px="3"
      py="1.5"
      text="xs"
      font="700"
      dark="bg-dark-surface"
    >
      계산 전
    </div>
    <div
      id="severance-summary"
      grid="~ cols-1 sm:cols-2 lg:cols-3"
      gap="3"
      mt="5"
    ></div>
    <div
      id="severance-breakdown"
      mt="5"
      rounded-xl
      border="1"
      border-border
      bg-surface
      p="4"
      dark="border-dark-border bg-dark-surface"
    ></div>
  </section>

  <p
    m="4 0 0"
    text="xs"
    leading="5"
    text-text-muted
    dark="text-dark-text-muted"
  >
    참고용 모의계산입니다. 실제 퇴직금은 평균임금 산정 제외기간, 임금 포함 여부,
    통상임금, 계속근로관계 등에 따라 달라질 수 있습니다.
  </p>

<script>
  import {
    calculateSeverance,
    getSeverancePeriod,
  } from '../../lib/calculators/severance';
  import { parseNumber } from '../../lib/calculators/number-input';
  import { bindCalculatorInputs } from '../../lib/calculators/runtime';

  const root = document.querySelector<HTMLElement>(
    '[data-severance-calculator]',
  );

  if (root) {
    const $ = <T extends HTMLElement>(id: string) =>
      root.querySelector<T>('#' + id);
    const start = $('severance-start') as HTMLInputElement;
    const retirement = $('severance-retirement') as HTMLInputElement;
    const periodText = $('severance-period') as HTMLElement;
    const months = $('severance-months') as HTMLElement;
    const value = $('severance-value') as HTMLElement;
    const eligibility = $('severance-eligibility') as HTMLElement;
    const summary = $('severance-summary') as HTMLElement;
    const breakdown = $('severance-breakdown') as HTMLElement;
    const error = $('severance-error') as HTMLElement;

    const fmt = (number: number) => Math.round(number).toLocaleString('ko-KR');
    const won = (number: number) => fmt(number) + '원';

    const renderMonths = () => {
      if (!retirement.value) {
        months.innerHTML = '';
        periodText.textContent = '퇴직일을 입력하면 산정기간이 표시됩니다.';
        return;
      }

      try {
        const period = getSeverancePeriod(retirement.value);
        periodText.textContent =
          period.start + ' ~ ' + period.end + ' · 총 ' + period.days + '일';
        months.innerHTML = period.periods
          .map(
            (item, index) =>
              '<label class="cm-card" p="4">' +
              '<span class="cm-label">' +
              (index + 1) +
              '개월차 · ' +
              item.start +
              ' ~ ' +
              item.end +
              '</span>' +
              '<div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">' +
              '<button type="button" data-step-direction="-1" aria-label="임금 감소" class="cm-step-button">−</button>' +
              '<div relative><input id="severance-wage-' +
              index +
              '" class="cm-input pr-12" type="text" inputmode="numeric" value="0" data-number-input data-step="10000" data-min="0" data-decimal="false" />' +
              '<span absolute right="4" top="[50%]" translate-y="[-50%]" text="sm" text-text-muted dark="text-dark-text-muted">원</span></div>' +
              '<button type="button" data-step-direction="1" aria-label="임금 증가" class="cm-step-button">+</button>' +
              '</div><span mt="1.5" block text="xs" text-text-muted dark="text-dark-text-muted">' +
              item.days +
              '일</span></label>',
          )
          .join('');
      } catch {
        months.innerHTML = '';
        periodText.textContent = '퇴직일을 확인하세요.';
      }
    };

    const calculate = () => {
      error.hidden = true;
      try {
        const monthlyWages: [number, number, number] = [
          parseNumber(
            ($('severance-wage-0') as HTMLInputElement | null)?.value ?? '0',
          ),
          parseNumber(
            ($('severance-wage-1') as HTMLInputElement | null)?.value ?? '0',
          ),
          parseNumber(
            ($('severance-wage-2') as HTMLInputElement | null)?.value ?? '0',
          ),
        ];

        const result = calculateSeverance({
          startDate: start.value,
          retirementDate: retirement.value,
          monthlyWages,
          annualBonus: parseNumber(
            ($('severance-bonus') as HTMLInputElement).value,
          ),
          annualLeaveAllowance: parseNumber(
            ($('severance-leave') as HTMLInputElement).value,
          ),
          ordinaryDailyWage:
            parseNumber(($('severance-ordinary') as HTMLInputElement).value) ||
            undefined,
          weeklyHours: parseNumber(
            ($('severance-hours') as HTMLInputElement).value,
          ),
          excludedAverageWageDays: parseNumber(
            ($('severance-excluded-days') as HTMLInputElement).value,
          ),
          excludedAverageWageAmount: parseNumber(
            ($('severance-excluded-amount') as HTMLInputElement).value,
          ),
        });

        value.textContent = won(result.severancePay);
        eligibility.textContent = result.eligible
          ? '지급 대상 가능'
          : '지급 대상 확인 필요';

        const cards = [
          ['총 재직일수', fmt(result.serviceDays) + '일'],
          ['근속기간', result.serviceYears.toFixed(2) + '년'],
          ['1일 평균임금', won(result.averageDailyWage)],
          ['적용 1일 임금', won(result.appliedDailyWage)],
          ['3개월 임금', won(result.threeMonthWages)],
          ['상여금 산입액', won(result.bonusIncluded)],
          ['연차수당 산입액', won(result.leaveAllowanceIncluded)],
          ['평균임금 산정기간', fmt(result.averageWagePeriodDays) + '일'],
          [
            '적용 기준',
            result.appliedBasis === 'ordinary'
              ? '1일 통상임금'
              : '1일 평균임금',
          ],
        ];

        summary.innerHTML = cards
          .map(
            (card) =>
              '<div rounded-xl border="1" border-border bg-surface p="4" dark="border-dark-border bg-dark-surface">' +
              '<p m="0" text="xs" text-text-muted dark="text-dark-text-muted">' +
              card[0] +
              '</p>' +
              '<p m="1 0 0" text="base" font="800">' +
              card[1] +
              '</p></div>',
          )
          .join('');

        breakdown.innerHTML =
          '<p m="0" font="700">계산 과정</p>' +
          '<p m="2 0 0" text="sm" leading="6" text-text-muted dark="text-dark-text-muted">평균임금 산정기간: ' +
          result.averageWagePeriodStart +
          ' ~ ' +
          result.averageWagePeriodEnd +
          ' (' +
          fmt(result.averageWagePeriodDays) +
          '일)</p>' +
          '<p m="2 0 0" text="sm" leading="6" text-text-muted dark="text-dark-text-muted">산정 대상 임금 = ' +
          won(result.threeMonthWages) +
          ' + 상여금 ' +
          won(result.bonusIncluded) +
          ' + 연차수당 ' +
          won(result.leaveAllowanceIncluded) +
          (result.excludedAmount > 0
            ? ' − 제외임금 ' + won(result.excludedAmount)
            : '') +
          '</p>' +
          '<p m="2 0 0" text="sm" leading="6" text-text-muted dark="text-dark-text-muted">1일 평균임금 = ' +
          won(result.averageWageAmount) +
          ' ÷ ' +
          fmt(result.averageWagePeriodDays - result.excludedDays) +
          '일 = ' +
          won(result.averageDailyWage) +
          '</p>' +
          (result.ordinaryDailyWage !== null
            ? '<p m="2 0 0" text="sm" leading="6" text-text-muted dark="text-dark-text-muted">1일 통상임금 ' +
              won(result.ordinaryDailyWage) +
              '과 비교하여 ' +
              (result.appliedBasis === 'ordinary' ? '통상임금' : '평균임금') +
              '을 적용했습니다.</p>'
            : '') +
          '<p m="2 0 0" text="sm" leading="6" font="700">퇴직금 = ' +
          won(result.appliedDailyWage) +
          ' × 30 × ' +
          fmt(result.serviceDays) +
          ' ÷ 365 = ' +
          won(result.severancePay) +
          '</p>' +
          '<p m="2 0 0" text="sm" leading="6" text-text-muted dark="text-dark-text-muted">' +
          result.eligibilityReason +
          '</p>';
      } catch (caught) {
        value.textContent = '계산 불가';
        eligibility.textContent = '입력값 확인';
        error.hidden = false;
        error.textContent =
          caught instanceof Error ? caught.message : '입력값을 확인하세요.';
      }
    };

    const reset = () => {
      start.value = '2021-10-01';
      retirement.value = '2026-10-01';
      [
        'severance-bonus',
        'severance-leave',
        'severance-ordinary',
        'severance-excluded-days',
        'severance-excluded-amount',
      ].forEach((id) => {
        (root.querySelector('#' + id) as HTMLInputElement).value = '0';
      });
      (root.querySelector('#severance-hours') as HTMLInputElement).value = '40';
      renderMonths();
      calculate();
    };

    renderMonths();
    $('severance-calculate')?.addEventListener('click', calculate);
    $('severance-reset')?.addEventListener('click', reset);
    retirement.addEventListener('change', () => {
      renderMonths();
      calculate();
    });
    start.addEventListener('change', calculate);
    bindCalculatorInputs(root, calculate, { change: true });
    calculate();
  }
</script>
