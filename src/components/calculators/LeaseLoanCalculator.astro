---
---

<div data-calculator="leaseLoan">
  <div id="fields" grid="~ cols-1 md:cols-2" gap="4">
    <label class="cm-field">
      <span class="cm-label">임차보증금</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="임차보증금 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input pr-12"
            id="deposit"
            type="text"
            inputmode="numeric"
            value="200000000"
            data-default-value="200000000"
            data-number-input
            data-step="100000"
            data-min="0"
            data-decimal="false"
          />
          <span
            absolute
            right-4
            top="[50%]"
            translate-y="[-50%]"
            text="sm"
            text-text-muted
            dark="text-dark-text-muted"
          >
            원
          </span>
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="임차보증금 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </label>
    <label class="cm-field">
      <span class="cm-label">대출비율</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="대출비율 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input pr-14"
            id="loanRate"
            type="text"
            inputmode="decimal"
            value="80"
            data-default-value="80"
            data-number-input
            data-step="1"
            data-min="0"
            data-decimal="true"
          />
          <span
            absolute
            right-4
            top="[50%]"
            translate-y="[-50%]"
            text="sm"
            text-text-muted
            dark="text-dark-text-muted"
          >
            %
          </span>
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="대출비율 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </label>
    <label class="cm-field">
      <span class="cm-label">연이율</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="연이율 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input pr-14"
            id="rate"
            type="text"
            inputmode="decimal"
            value="3.5"
            data-default-value="3.5"
            data-number-input
            data-step="0.1"
            data-min="0"
            data-decimal="true"
          />
          <span
            absolute
            right-4
            top="[50%]"
            translate-y="[-50%]"
            text="sm"
            text-text-muted
            dark="text-dark-text-muted"
          >
            %
          </span>
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="연이율 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </label>
  </div>
  <div
    id="result"
    aria-live="polite"
    aria-atomic="true"
    mt="5"
    rounded="2xl"
    bg="primary/10"
    p="5"
    dark="bg-dark-primary-surface"
  >
    <p m="0" class="cm-help-text">
      계산 결과
    </p>
    <div id="result-value" mt="2" text="2xl md:3xl" font="800" text-primary>
      -
    </div>
    <div
      id="result-detail"
      mt="3"
      class="cm-help-text"
      text="sm"
      leading="7"
    ></div>
  </div>
  <div grid="~ cols-1 sm:cols-2" gap="3" mt="5">
    <button id="calculate" type="button" class="cm-button-primary" py="3">
      계산하기
    </button>
    <button id="reset" type="button" class="cm-button-secondary" py="3">
      초기화
    </button>
  </div>
</div>

<script>
  import { bindNumberControls } from '../../lib/calculators/number-input';
  import { bindLiveCalculation } from '../../lib/calculators/runtime';
  import {
    formatCalculatorNumber,
    formatCalculatorWon,
    getCalculatorField,
    readCalculatorNumber,
    resetCalculatorFields,
  } from '../../lib/calculators/dom';
  import { resetCalculatorFields } from '../../lib/calculators/dom';

  const root = document.querySelector<HTMLElement>(
    '[data-calculator="leaseLoan"]',
  );
  if (root) {
    const fields = root.querySelector<HTMLElement>('#fields')!;
    const out = root.querySelector<HTMLElement>('#result-value')!;
    const detail = root.querySelector<HTMLElement>('#result-detail')!;
    bindNumberControls(fields);

    const calc = () => {
      const loan = (readCalculatorNumber(root, 'deposit') * readCalculatorNumber(root, 'loanRate')) / 100;
      const value = (loan * readCalculatorNumber(root, 'rate')) / 100;
      out.textContent = formatCalculatorWon(value);
      detail.textContent = `예상 대출금: ${formatCalculatorWon(loan)} · 1년 단순 이자: ${formatCalculatorWon(value)}`;
    };

    const reset = () => {
      resetCalculatorFields(fields);
      calc();
    };

    root.querySelector('#calculate')?.addEventListener('click', calc);
    root.querySelector('#reset')?.addEventListener('click', reset);
    bindLiveCalculation(fields, calc);
    calc();
  }
</script>
