---
---

<div data-calculator="percentage">
  <div id="fields" grid="~ cols-1 md:cols-2" gap="4">
    <label class="cm-field">
      <span class="cm-label">계산 유형</span>
      <select class="cm-input" id="percentageMode">
        <option value="Y의 X% 계산">Y의 X% 계산</option>
        <option value="X는 Y의 몇 %인지 계산">X는 Y의 몇 %인지 계산</option>
        <option value="이전 값에서 새 값으로의 증감률">
          이전 값에서 새 값으로의 증감률
        </option>
        <option value="기준값의 X% 증가·감소 후 값">
          기준값의 X% 증가·감소 후 값
        </option>
        <option value="X%에 해당하는 원래 값">X%에 해당하는 원래 값</option>
        <option value="두 비율의 퍼센트포인트 차이">
          두 비율의 퍼센트포인트 차이
        </option>
      </select>
    </label>
    <label class="cm-field">
      <span class="cm-label">첫 번째 값</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="첫 번째 값 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input"
            id="valueA"
            type="text"
            inputmode="decimal"
            value="100000"
            data-default-value="100000"
            data-number-input
            data-step="1"
            data-min="0"
            data-decimal="true"
          />
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="첫 번째 값 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </label>
    <label class="cm-field">
      <span class="cm-label">두 번째 값</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="두 번째 값 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input"
            id="valueB"
            type="text"
            inputmode="decimal"
            value="15"
            data-default-value="15"
            data-number-input
            data-step="1"
            data-min="0"
            data-decimal="true"
          />
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="두 번째 값 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </label>
    <label class="cm-field">
      <span class="cm-label">증가·감소</span>
      <select class="cm-input" id="percentageDirection">
        <option value="증가">증가</option>
        <option value="감소">감소</option>
      </select>
    </label>
  </div>
  <div
    id="result"
    aria-live="polite"
    aria-atomic="true"
    mt="5"
    rounded="2xl"
    bg="primary/10"
    p="5"
    dark="bg-dark-primary-surface"
  >
    <p class="cm-help-text" text="sm">
      계산 결과
    </p>
    <div id="result-value" mt="2" text="2xl md:3xl" font="800" text-primary>
      -
    </div>
    <div id="result-detail" class="cm-help-text" mt="3"></div>
  </div>
  <div grid="~ cols-1 sm:cols-2" gap="3" mt="5">
    <button id="calculate" class="cm-button-primary" py="3">
      계산하기
    </button>
    <button id="reset" class="cm-button-secondary" py="3">
      초기화
    </button>
  </div>
</div>

<script>
  import { bindNumberControls } from '../../lib/calculators/number-input';
  import { bindLiveCalculation } from '../../lib/calculators/runtime';

  const root = document.querySelector<HTMLElement>(
    '[data-calculator="percentage"]',
  );
  if (root) {
    const fields = root.querySelector<HTMLElement>('#fields')!;
    const out = root.querySelector<HTMLElement>('#result-value')!;
    const detail = root.querySelector<HTMLElement>('#result-detail')!;
    const $ = (id: string) =>
      root.querySelector<HTMLInputElement | HTMLSelectElement>('#' + id);
    const n = (id: string) => {
      const value = ($(id) as HTMLInputElement | undefined)?.value ?? '';
      return Number(value.replace(/,/g, '') || 0);
    };
    const fmt = (v: number, d = 0) =>
      Number.isFinite(v)
        ? v.toLocaleString('ko-KR', { maximumFractionDigits: d })
        : '-';
    const won = (v: number) => fmt(v) + '원';

    bindNumberControls(fields);

    const calc = () => {
      const mode = $('percentageMode')?.value ?? 'Y의 X% 계산';
      const a = n('valueA');
      const b = n('valueB');

      if (mode === 'Y의 X% 계산') {
        const value = (a * b) / 100;
        out.textContent = won(value);
        detail.textContent = `${won(a)}의 ${fmt(b, 2)}% = ${won(value)} · 공식: ${fmt(a, 2)} × ${fmt(b, 2)} ÷ 100`;
        return;
      }

      if (mode === 'X는 Y의 몇 %인지 계산') {
        const value = b === 0 ? NaN : (a / b) * 100;
        out.textContent = fmt(value, 2) + '%';
        detail.textContent =
          b === 0
            ? '전체값은 0이 될 수 없습니다.'
            : `${won(a)}은 ${won(b)}의 ${fmt(value, 2)}%입니다 · 공식: ${fmt(a, 2)} ÷ ${fmt(b, 2)} × 100`;
        return;
      }

      if (mode === '이전 값에서 새 값으로의 증감률') {
        const value = a === 0 ? NaN : ((b - a) / a) * 100;
        out.textContent = fmt(value, 2) + '%';
        detail.textContent =
          a === 0
            ? '이전 값은 0이 될 수 없습니다.'
            : `${won(a)} → ${won(b)}: ${value >= 0 ? '증가' : '감소'} ${fmt(Math.abs(value), 2)}% · 공식: (${fmt(b, 2)} - ${fmt(a, 2)}) ÷ ${fmt(a, 2)} × 100`;
        return;
      }

      if (mode === '기준값의 X% 증가·감소 후 값') {
        const direction = $('percentageDirection')?.value ?? '증가';
        const value = a * (direction === '증가' ? 1 + b / 100 : 1 - b / 100);
        out.textContent = won(value);
        detail.textContent = `${won(a)}에 ${fmt(b, 2)}% ${direction}를 적용한 결과입니다 · 공식: ${fmt(a, 2)} × (1 ${direction === '증가' ? '+' : '-'} ${fmt(b, 2)} ÷ 100)`;
        return;
      }

      if (mode === 'X%에 해당하는 원래 값') {
        const value = b === 0 ? NaN : (a * 100) / b;
        out.textContent = won(value);
        detail.textContent =
          b === 0
            ? '퍼센트 값은 0이 될 수 없습니다.'
            : `${fmt(b, 2)}%가 ${won(a)}라면 원래 값은 ${won(value)}입니다 · 공식: ${fmt(a, 2)} × 100 ÷ ${fmt(b, 2)}`;
        return;
      }

      const value = b - a;
      out.textContent = fmt(value, 2) + '%p';
      detail.textContent = `${fmt(a, 2)}% → ${fmt(b, 2)}%: ${value >= 0 ? '+' : ''}${fmt(value, 2)}%p · 퍼센트포인트는 두 비율의 단순한 차이입니다.`;
    };

    const reset = () => {
      fields.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
        const defaultValue = input.dataset.defaultValue;
        if (defaultValue !== undefined) {
          input.value = defaultValue;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      });
      fields.querySelectorAll<HTMLSelectElement>('select').forEach((select) => {
        select.selectedIndex = 0;
      });
      calc();
    };

    root.querySelector('#calculate')?.addEventListener('click', calc);
    root.querySelector('#reset')?.addEventListener('click', reset);
    bindLiveCalculation(fields, calc);
    calc();
  }
</script>
