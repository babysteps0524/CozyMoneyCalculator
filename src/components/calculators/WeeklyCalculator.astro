---
---

<div data-calculator="weekly">
  <div id="fields" grid="~ cols-1 md:cols-2" gap="4">
    <label class="cm-field">
      <span class="cm-label">시급</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="시급 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input pr-12"
            id="hourly"
            type="text"
            inputmode="numeric"
            value="12000"
            data-default-value="12000"
            data-number-input
            data-step="100"
            data-min="0"
            data-decimal="false"
          />
          <span
            absolute
            right-4
            top="[50%]"
            translate-y="[-50%]"
            text="sm"
            text-text-muted
            dark="text-dark-text-muted"
          >
            원
          </span>
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="시급 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </label>
    <label class="cm-field">
      <span class="cm-label">주 소정근로시간</span>
      <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
        <button
          type="button"
          data-step-direction="-1"
          aria-label="주 소정근로시간 감소"
          class="cm-step-button"
        >
          −
        </button>
        <div relative>
          <input
            class="cm-input pr-14"
            id="hours"
            type="text"
            inputmode="numeric"
            value="40"
            data-default-value="40"
            data-number-input
            data-step="1"
            data-min="0"
            data-decimal="false"
          />
          <span
            absolute
            right-4
            top="[50%]"
            translate-y="[-50%]"
            text="sm"
            text-text-muted
            dark="text-dark-text-muted"
          >
            시간
          </span>
        </div>
        <button
          type="button"
          data-step-direction="1"
          aria-label="주 소정근로시간 증가"
          class="cm-step-button"
        >
          +
        </button>
      </div>
    </label>
  </div>
  <div
    id="result"
    aria-live="polite"
    aria-atomic="true"
    mt="5"
    rounded="2xl"
    bg="primary/10"
    p="5"
    dark="bg-dark-primary-surface"
  >
    <p class="cm-help-text" text="sm">
      계산 결과
    </p>
    <div id="result-value" mt="2" text="2xl md:3xl" font="800" text-primary>
      -
    </div>
    <div id="result-detail" class="cm-help-text" mt="3"></div>
  </div>
  <div grid="~ cols-1 sm:cols-2" gap="3" mt="5">
    <button id="calculate" type="button" class="cm-button-primary" py="3">
      계산하기
    </button>
    <button id="reset" type="button" class="cm-button-secondary" py="3">
      초기화
    </button>
  </div>
</div>

<script>
  import { bindNumberControls } from '../../lib/calculators/number-input';
  import { bindLiveCalculation } from '../../lib/calculators/runtime';
  import {
    formatCalculatorNumber,
    formatCalculatorWon,
    getCalculatorField,
    readCalculatorNumber,
    resetCalculatorFields,
  } from '../../lib/calculators/dom';
  import { resetCalculatorFields } from '../../lib/calculators/dom';

  const root = document.querySelector<HTMLElement>(
    '[data-calculator="weekly"]',
  );
  if (root) {
    const fields = root.querySelector<HTMLElement>('#fields')!;
    const out = root.querySelector<HTMLElement>('#result-value')!;
    const detail = root.querySelector<HTMLElement>('#result-detail')!;
    bindNumberControls(fields);

    const calc = () => {
      const weeklyHoliday =
        readCalculatorNumber(root, 'hours') >= 15 ? readCalculatorNumber(root, 'hourly') * Math.min(8, readCalculatorNumber(root, 'hours')) : 0;
      const value = readCalculatorNumber(root, 'hourly') * readCalculatorNumber(root, 'hours') + weeklyHoliday;
      out.textContent = formatCalculatorWon(value);
      detail.textContent =
        '입력한 소정근로시간을 기준으로 주급과 주휴수당을 단순 합산했습니다.';
    };

    const reset = () => {
      resetCalculatorFields(fields);
      calc();
    };

    root.querySelector('#calculate')?.addEventListener('click', calc);
    root.querySelector('#reset')?.addEventListener('click', reset);
    bindLiveCalculation(fields, calc);
    calc();
  }
</script>
