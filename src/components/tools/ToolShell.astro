---
import AdSlot from '../common/AdSlot.astro';
import type { ToolDefinition } from '../../data/tools';
import LottoTool from './panels/LottoTool.astro';
import RandomNumberTool from './panels/RandomNumberTool.astro';
import RandomPickerTool from './panels/RandomPickerTool.astro';
import PasswordTool from './panels/PasswordTool.astro';
import DateCalculatorTool from './panels/DateCalculatorTool.astro';
import DdayTool from './panels/DdayTool.astro';
import AgeCalculatorTool from './panels/AgeCalculatorTool.astro';
import UnitConverterTool from './panels/UnitConverterTool.astro';
import PercentCalculatorTool from './panels/PercentCalculatorTool.astro';

interface Props {
  kind: ToolDefinition['kind'];
  title: string;
  description: string;
}

const { kind, title, description } = Astro.props;
<section class="cm-tool-shell" data-tool={kind}>
  <div class="grid min-w-0 gap-4 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-6">
    <div min-w="0">
    <div class="cm-card p-5 md:p-7">
      {kind === 'lotto' && <LottoTool />}


