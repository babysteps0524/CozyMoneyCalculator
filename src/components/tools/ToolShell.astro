---
import AdSlot from '../common/AdSlot.astro';
import type { ToolDefinition } from '../../data/tools';
import ToolPanel from './ToolPanel.astro';
import ToolInfo from './ToolInfo.astro';

interface Props {
  kind: ToolDefinition['kind'];
  title: string;
  description: string;
}

const { kind, title, description } = Astro.props;
---

<section class="cm-tool-shell" data-tool={kind}>
  <div class="grid min-w-0 gap-4 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-6">
    <div min-w="0">
      <div class="cm-card p-5 md:p-7">
        <ToolPanel kind={kind} />
      </div>
    </div>
    <ToolInfo title={title} description={description} />
  </div>

  <AdSlot slot={import.meta.env.PUBLIC_ADSENSE_SLOT_TOOL || ''} />
</section>

<script>
import { createToolHelpers } from '../../scripts/tools/shared';
import { mountTool } from '../../scripts/tools/registry';
import type { ToolKind } from '../../scripts/tools/types';

const root = document.querySelector<HTMLElement>('[data-tool]');
if (root) {
  const helpers = createToolHelpers(root);
  void mountTool(root, helpers, root.dataset.tool as ToolKind | undefined);
}
</script>
