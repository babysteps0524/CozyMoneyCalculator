---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";

const groups = [
  { title: "금융 계산기", description: "대출과 저축에 필요한 계산", items: [
    { title: "대출 계산기", description: "월 상환금액과 총 이자를 계산합니다.", href: "/calculators/loan/" },
    { title: "예적금 계산기", description: "예금과 적금의 예상 만기금액을 계산합니다.", href: "/calculators/savings/" },
  ]},
  { title: "급여 계산기", description: "연봉을 기준으로 월급과 시급 확인", items: [
    { title: "연봉 계산기", description: "연봉을 기준으로 예상 월급과 시급을 계산합니다.", href: "/calculators/salary/" },
  ]},
  { title: "생활 도구", description: "일상에서 자주 사용하는 간편 도구", items: [
    { title: "로또 번호 생성기", description: "1~45 사이에서 무작위 번호를 생성합니다.", href: "/tools/lotto/" },
    { title: "랜덤 숫자 생성기", description: "원하는 범위의 랜덤 숫자를 생성합니다.", href: "/tools/random/" },
    { title: "랜덤 추첨기", description: "목록에서 무작위로 하나를 추첨합니다.", href: "/tools/picker/" },
    { title: "비밀번호 생성기", description: "설정한 조건으로 무작위 비밀번호를 생성합니다.", href: "/tools/password/" },
    { title: "날짜 계산기", description: "두 날짜 사이의 기간을 계산합니다.", href: "/tools/date/" },
    { title: "D-Day 계산기", description: "목표 날짜까지 남은 기간을 계산합니다.", href: "/tools/dday/" },
    { title: "나이 계산기", description: "생년월일 기준 만 나이를 계산합니다.", href: "/tools/age/" },
    { title: "단위 변환기", description: "생활에 필요한 단위를 빠르게 변환합니다.", href: "/tools/unit/" },
    { title: "퍼센트 계산기", description: "비율과 증감률, 할인율을 계산합니다.", href: "/tools/percent/" },
  ]},
];
---
<BaseLayout title="CozyMoney | 생활 계산기와 유용한 도구" description="대출, 예적금, 연봉 계산기부터 로또 번호 생성기, 날짜, 나이, 단위, 퍼센트 등 생활에 필요한 계산과 도구를 제공합니다." canonical="https://cozymoney.kr/">
  <Header />
  <main>
    <section class="cm-container" py="10 md:16 lg:22">
      <div rounded="3xl" border="1" border-border bg="surface-muted" p="6 md:10 lg:14" dark="border-dark-border bg-dark-surface-muted">
        <p m="0" mb="3" text="sm" font="700" text-primary>CALCULATORS & TOOLS</p>
        <h1 m="0" max-w="3xl" text="3xl md:4xl lg:5xl" font="800" tracking-tight leading-tight>필요한 계산과 도구를<br />한곳에서 간편하게</h1>
        <p m="0" mt="5" max-w="2xl" text="base md:lg" leading="7" text-text-muted dark="text-dark-text-muted">복잡한 숫자 계산부터 날짜, 나이, 단위 변환과 랜덤 도구까지 필요한 기능을 간단하게 이용할 수 있습니다.</p>
        <div flex="~ wrap" gap="2" mt="6">
          <a href="/calculators/" class="cm-button-primary" px="5" py="3" text="sm md:base" no-underline>계산기 보기</a>
          <a href="/tools/" class="cm-button-secondary" px="5" py="3" text="sm md:base" no-underline>생활도구 보기</a>
        </div>
      </div>
    </section>
    
    <section class="cm-container" pb="16 md:20">
      <div flex="~ col" gap="10 md:12">
        {groups.map((group) => (
          <section>
            <div mb="5 md:6">
              <p m="0" text="sm" font="700" text-primary>{group.title === "생활 도구" ? "LIFE TOOLS" : "CALCULATORS"}</p>
              <h2 class="cm-section-title" mt="1">{group.title}</h2>
              <p m="0" mt="1" text="sm" text-text-muted dark="text-dark-text-muted">{group.description}</p>
            </div>
            <div grid="~ cols-1 sm:cols-2 lg:cols-3" gap="3 md:4">
              {group.items.map((item) => (
                <a href={item.href} class="cm-card-interactive" p="5 md:6" no-underline>
                  <div flex="~" items-center justify-between gap="3">
                    <h3 m="0" text="lg md:xl" font="750" text-text dark="text-dark-text">{item.title}</h3>
                    <span text="text-subtle" dark="text-dark-text-subtle">→</span>
                  </div>
                  <p m="0" mt="2" text="sm" leading="6" text-text-muted dark="text-dark-text-muted">{item.description}</p>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
