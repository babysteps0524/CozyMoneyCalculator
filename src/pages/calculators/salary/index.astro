---
import CalculatorDetails from '../../../components/calculators/CalculatorDetails.astro';
import { supplementalCalculatorDetails } from '../../../lib/calculators/guidance';
import CalculatorPage from '../../../components/calculators/CalculatorPage.astro';
import AdSlot from '../../../components/common/AdSlot.astro';
---

<CalculatorPage
  mode="custom"
  title="연봉 계산기 | CozyMoney 코지머니"
  description="연봉 또는 월급, 퇴직금 포함 여부, 비과세액, 부양가족을 입력해 예상 실수령액과 4대보험 공제액을 계산합니다."
  canonical="https://cozymoney.kr/calculators/salary/"
>
  <main class="cm-container" py="8 md:12 lg:16">
    <div max-w="5xl" mx="auto">
      <nav mb="5" text="xs sm:sm" text-text-muted dark="text-dark-text-muted">
        <a href="/" hover="text-primary" no-underline>
          홈
        </a>
        <span mx="2">/</span>
        <a href="/calculators/" hover="text-primary" no-underline>
          계산기
        </a>
        <span mx="2">/</span>
        <span>연봉</span>
      </nav>

      <header mb="6 md:8">
        <p m="0" text="sm" font="700" text-primary>
          급여 계산기
        </p>
        <h1 m="0" mt="2" text="3xl md:4xl" font="800">
          연봉 계산기
        </h1>
        <p
          m="0"
          mt="3"
          text="sm md:base"
          leading="7"
          text-text-muted
          dark="text-dark-text-muted"
        >
          연봉·월급과 퇴직금, 비과세액, 부양가족을 반영해 예상 월 실수령액과
          공제항목을 확인하세요.
        </p>
      </header>

      <div grid="~ cols-1 lg:cols-2" gap="4 md:6" items-start>
        <section class="cm-card" p="5 md:7">
          <h2 m="0" text="lg md:xl" font="750">
            급여 입력
          </h2>
          <p m="0" mt="1" text="sm" text-text-muted dark="text-dark-text-muted">
            실제 급여명세서와 계약조건에 맞춰 입력하면 더 현실적인 추정값을
            확인할 수 있습니다.
          </p>

          <form id="salary-form" mt="6">
            <div
              grid="~ cols-2"
              gap="2"
              p="1"
              rounded="xl"
              bg="surface-subtle"
              dark="bg-dark-surface-subtle"
            >
              <label>
                <input
                  id="salary-type-annual"
                  type="radio"
                  name="salaryType"
                  value="annual"
                  checked
                  sr-only
                />
                <span
                  id="salary-type-annual-label"
                  class="cm-button-secondary"
                  block
                  py="2.5"
                  text="center sm"
                >
                  연봉 입력
                </span>
              </label>
              <label>
                <input
                  id="salary-type-monthly"
                  type="radio"
                  name="salaryType"
                  value="monthly"
                  sr-only
                />
                <span
                  id="salary-type-monthly-label"
                  class="cm-button-secondary"
                  block
                  py="2.5"
                  text="center sm"
                >
                  월급 입력
                </span>
              </label>
            </div>

            <label class="cm-label" for="salary" mt="5">
              연봉 또는 월급
            </label>
            <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
              <button
                type="button"
                data-step-direction="-1"
                aria-label="급여 감소"
                class="cm-step-button"
              >
                −
              </button>
              <div relative>
                <input
                  class="cm-input"
                  id="salary"
                  type="text"
                  inputmode="numeric"
                  value="40,000,000"
                  data-number-input
                  data-step="100000"
                  data-min="1"
                  data-decimal="false"
                  pr="12"
                />
                <span
                  absolute
                  right-4
                  top="[50%]"
                  translate-y="[-50%]"
                  text="sm"
                  text-text-muted
                  dark="text-dark-text-muted"
                >
                  원
                </span>
              </div>
              <button
                type="button"
                data-step-direction="1"
                aria-label="급여 증가"
                class="cm-step-button"
              >
                +
              </button>
            </div>

            <fieldset mt="5" border="0" p="0">
              <legend class="cm-label">퇴직금</legend>
              <div grid="~ cols-2" gap="2">
                <label>
                  <input
                    id="retirement-separate"
                    type="radio"
                    name="retirement"
                    value="separate"
                    checked
                    sr-only
                  />
                  <span
                    id="retirement-separate-label"
                    class="cm-button-secondary"
                    block
                    py="2.5"
                    text="center sm"
                  >
                    별도
                  </span>
                </label>
                <label>
                  <input
                    id="retirement-included"
                    type="radio"
                    name="retirement"
                    value="included"
                    sr-only
                  />
                  <span
                    id="retirement-included-label"
                    class="cm-button-secondary"
                    block
                    py="2.5"
                    text="center sm"
                  >
                    포함
                  </span>
                </label>
              </div>
              <p
                m="0"
                mt="2"
                text="xs"
                leading="6"
                text-text-subtle
                dark="text-dark-text-subtle"
              >
                퇴직금 포함을 선택하면 연봉 입력 시 연봉을 13으로 나누고, 월급
                입력 시 입력한 월급을 계약상 월 지급액으로 봅니다.
              </p>
            </fieldset>

            <label class="cm-label" for="tax-free" mt="5">
              비과세액(월)
            </label>
            <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
              <button
                type="button"
                data-step-direction="-1"
                aria-label="비과세액 감소"
                class="cm-step-button"
              >
                −
              </button>
              <div relative>
                <input
                  class="cm-input"
                  id="tax-free"
                  type="text"
                  inputmode="numeric"
                  value="200,000"
                  data-number-input
                  data-step="10000"
                  data-min="0"
                  data-decimal="false"
                  pr="12"
                />
                <span
                  absolute
                  right-4
                  top="[50%]"
                  translate-y="[-50%]"
                  text="sm"
                  text-text-muted
                  dark="text-dark-text-muted"
                >
                  원
                </span>
              </div>
              <button
                type="button"
                data-step-direction="1"
                aria-label="비과세액 증가"
                class="cm-step-button"
              >
                +
              </button>
            </div>

            <div grid="~ cols-1 sm:cols-2" gap="3" mt="5">
              <div>
                <label class="cm-label" for="dependents">
                  부양가족 수(본인 포함)
                </label>
                <div
                  grid="~ cols-[auto_minmax(0,1fr)_auto]"
                  items-center
                  gap="2"
                >
                  <button
                    type="button"
                    data-step-direction="-1"
                    aria-label="부양가족 감소"
                    class="cm-step-button"
                  >
                    −
                  </button>
                  <input
                    class="cm-input"
                    id="dependents"
                    type="text"
                    inputmode="numeric"
                    value="1"
                    data-number-input
                    data-step="1"
                    data-min="1"
                    data-decimal="false"
                    text="center"
                  />
                  <button
                    type="button"
                    data-step-direction="1"
                    aria-label="부양가족 증가"
                    class="cm-step-button"
                  >
                    +
                  </button>
                </div>
              </div>
              <div>
                <label class="cm-label" for="children">
                  8~20세 자녀 수
                </label>
                <div
                  grid="~ cols-[auto_minmax(0,1fr)_auto]"
                  items-center
                  gap="2"
                >
                  <button
                    type="button"
                    data-control="children"
                    data-step="-1"
                    aria-label="자녀 수 감소"
                    class="cm-step-button"
                  >
                    −
                  </button>
                  <input
                    class="cm-input"
                    id="children"
                    type="text"
                    inputmode="numeric"
                    value="0"
                    data-number-input
                    data-step="1"
                    data-min="0"
                    data-decimal="false"
                    text="center"
                  />
                  <button
                    type="button"
                    data-control="children"
                    data-step="1"
                    aria-label="자녀 수 증가"
                    class="cm-step-button"
                  >
                    +
                  </button>
                </div>
              </div>
            </div>

            <div grid="~ cols-1 sm:cols-2" gap="3" mt="6">
              <button type="submit" class="cm-button-primary" py="3.5">
                계산하기
              </button>
              <button
                id="reset"
                type="button"
                class="cm-button-secondary"
                py="3.5"
              >
                초기화
              </button>
            </div>
            <p
              id="error"
              hidden
              m="0"
              mt="4"
              rounded="xl"
              bg="danger-surface"
              dark="bg-dark-danger-surface"
              px="4"
              py="3"
              text="sm"
              text-danger-text
              dark="text-dark-danger-text"
            ></p>
          </form>
        </section>

        <section id="result" class="cm-card" p="5 md:7" lg="sticky top-24">
          <div flex="~" items-center justify-between gap="3" mb="5">
            <div>
              <p m="0" text="xs" font="700" text-primary>
                RESULT
              </p>
              <h2 m="0" mt="1" text="lg md:xl" font="750">
                예상 실수령액
              </h2>
            </div>
            <button
              id="copy"
              type="button"
              class="cm-button-secondary"
              px="3"
              py="2"
              text="xs sm:sm"
            >
              결과 복사
            </button>
          </div>

          <div
            rounded="2xl"
            bg="primary/10"
            p="5"
            dark="bg-dark-primary-surface"
          >
            <p m="0" text="sm" text-text-muted dark="text-dark-text-muted">
              예상 월 실수령액
            </p>
            <strong
              id="take-home"
              block
              mt="2"
              text="2xl md:3xl"
              font="800"
              text-primary
            >
              -
            </strong>
          </div>

          <div grid="~ cols-2" gap="3" mt="3">
            <div class="cm-result">
              <p m="0" text="sm" text-text-muted dark="text-dark-text-muted">
                1일 8시간 기준 일급
              </p>
              <strong id="daily-wage-8h" block mt="2" text="lg">
                -
              </strong>
            </div>
            <div class="cm-result">
              <p m="0" text="sm" text-text-muted dark="text-dark-text-muted">
                예상 시급
              </p>
              <strong id="hourly-wage" block mt="2" text="lg">
                -
              </strong>
            </div>
          </div>

          <div grid="~ cols-2" gap="3" mt="3">
            <div class="cm-result">
              <p m="0" text="sm" text-text-muted dark="text-dark-text-muted">
                세전 월 급여
              </p>
              <strong id="monthly" block mt="2" text="lg">
                -
              </strong>
            </div>
            <div class="cm-result">
              <p m="0" text="sm" text-text-muted dark="text-dark-text-muted">
                예상 연간 실수령
              </p>
              <strong id="annual-take-home" block mt="2" text="lg">
                -
              </strong>
            </div>
          </div>

          <div
            mt="3"
            rounded="xl"
            border="1"
            border-border
            p="4"
            dark="border-dark-border"
          >
            <div flex="~" justify-between gap="3" text="sm">
              <span>국민연금</span>
              <strong id="pension">-</strong>
            </div>
            <div flex="~" justify-between gap="3" mt="2" text="sm">
              <span>건강보험</span>
              <strong id="health">-</strong>
            </div>
            <div flex="~" justify-between gap="3" mt="2" text="sm">
              <span>장기요양</span>
              <strong id="care">-</strong>
            </div>
            <div flex="~" justify-between gap="3" mt="2" text="sm">
              <span>고용보험</span>
              <strong id="employment">-</strong>
            </div>
            <div flex="~" justify-between gap="3" mt="2" text="sm">
              <span>소득세</span>
              <strong id="income-tax">-</strong>
            </div>
            <div flex="~" justify-between gap="3" mt="2" text="sm">
              <span>지방소득세</span>
              <strong id="local-tax">-</strong>
            </div>
            <div
              flex="~"
              justify-between
              gap="3"
              mt="3"
              pt="3"
              border-t="1"
              border-border
              font="750"
              dark="border-dark-border"
            >
              <span>공제액 합계</span>
              <strong id="total-deductions">-</strong>
            </div>
          </div>
        </section>
      </div>

      <AdSlot slot={import.meta.env.PUBLIC_ADSENSE_SLOT_CALCULATOR || ''} />

      <section mt="10 md:14">
        <h2 class="cm-section-title">핵심 기능 내역</h2>
        <div grid="~ cols-1 lg:cols-3" gap="4" mt="4">
          <div class="cm-card" p="5">
            <h3 m="0" font="750">
              연봉·월급 전환
            </h3>
            <p
              m="0"
              mt="3"
              text="sm"
              leading="7"
              text-text-muted
              dark="text-dark-text-muted"
            >
              연봉 입력과 월급 입력을 모두 지원하고 퇴직금 포함 여부에 따라 월
              급여 기준을 다르게 계산합니다.
            </p>
          </div>
          <div class="cm-card" p="5">
            <h3 m="0" font="750">
              공제항목 상세화
            </h3>
            <p
              m="0"
              mt="3"
              text="sm"
              leading="7"
              text-text-muted
              dark="text-dark-text-muted"
            >
              국민연금, 건강보험, 장기요양, 고용보험, 소득세, 지방소득세를
              분리해 보여줍니다.
            </p>
          </div>
          <div class="cm-card" p="5">
            <h3 m="0" font="750">
              가족·비과세 반영
            </h3>
            <p
              m="0"
              mt="3"
              text="sm"
              leading="7"
              text-text-muted
              dark="text-dark-text-muted"
            >
              월 비과세액, 본인 포함 부양가족, 8~20세 자녀 수를 입력해 소득세
              추정에 반영합니다.
            </p>
          </div>
        </div>
      </section>

      <section
        mt="6"
        rounded="2xl"
        border="1"
        border-border
        bg="surface-muted"
        p="5 md:6"
        dark="border-dark-border bg-dark-surface-muted"
      >
        <h2 m="0" font="750" dark="text-dark-text">
          계산 기준과 주의사항
        </h2>
        <ul
          m="0"
          mt="3"
          pl="5"
          text="sm"
          leading="7"
          text-text-muted
          dark="text-dark-text-muted"
        >
          <li>
            연봉 계산기는 연봉/월급, 퇴직금 별도·포함, 비과세액, 부양가족,
            8~20세 자녀를 입력받고 4대보험과 소득세 등을 공제해 예상 실수령액을
            보여줍니다.
          </li>
          <li>
            CozyMoney는 2026년 근로자 부담률을 기준으로 4대보험을 참고용
            추정하며, 소득세는 국세청 근로소득 간이세액표와 동일한 원천징수액을
            보장하지 않습니다.
          </li>
          <li>
            국세청은 월급여와 공제대상 가족수에 따라 근로소득 간이세액표로
            원천징수세액을 정한다고 안내합니다. 8~20세 자녀가 있으면 별도 금액을
            차감하는 방식도 안내하고 있습니다.
          </li>
          <li>
            실제 급여는 회사의 급여항목, 근로계약, 비과세 인정범위,
            중도입사·퇴사, 연말정산 등에 따라 달라질 수 있습니다.
          </li>
        </ul>
      </section>

      <section
        mt="8 md:10"
        rounded="2xl"
        border="1"
        border-border
        bg="surface-muted"
        p="5 md:6"
        dark="border-dark-border bg-dark-surface-muted"
      >
        <h2 m="0" text="sm" font="750" dark="text-dark-text">
          공통 이용 안내
        </h2>
        <ul
          m="0"
          mt="3"
          pl="5"
          text="sm"
          leading="7"
          text-text-muted
          dark="text-dark-text-muted"
        >
          <li>
            입력값은 이 페이지의 브라우저에서 계산하며 계산기 자체가 별도
            저장하지 않습니다.
          </li>
          <li>결과는 급여명세서나 세무신고용 확정금액이 아닌 예상값입니다.</li>
          <li>
            중요한 급여·세금 결정 전에는 회사 급여담당자 또는 국세청의 최신
            기준을 확인하세요.
          </li>
        </ul>
      </section>
    </div>
    <CalculatorDetails content={supplementalCalculatorDetails['salary']} />
  </main>
</CalculatorPage>

<script>
  import { calculateSalary, formatWon } from '../../../lib/calculators/salary';
  import {
    bindNumberControls,
    parseNumber,
  } from '../../../lib/calculators/number-input';

  const form = document.querySelector<HTMLFormElement>('#salary-form');
  const salary = document.querySelector<HTMLInputElement>('#salary');
  const taxFree = document.querySelector<HTMLInputElement>('#tax-free');
  const dependents = document.querySelector<HTMLInputElement>('#dependents');
  const children = document.querySelector<HTMLInputElement>('#children');
  const takeHome = document.querySelector<HTMLElement>('#take-home');
  const monthly = document.querySelector<HTMLElement>('#monthly');
  const annualTakeHome =
    document.querySelector<HTMLElement>('#annual-take-home');
  const dailyWage8h = document.querySelector<HTMLElement>('#daily-wage-8h');
  const hourlyWage = document.querySelector<HTMLElement>('#hourly-wage');
  const pension = document.querySelector<HTMLElement>('#pension');
  const health = document.querySelector<HTMLElement>('#health');
  const care = document.querySelector<HTMLElement>('#care');
  const employment = document.querySelector<HTMLElement>('#employment');
  const incomeTax = document.querySelector<HTMLElement>('#income-tax');
  const localTax = document.querySelector<HTMLElement>('#local-tax');
  const totalDeductions =
    document.querySelector<HTMLElement>('#total-deductions');
  const error = document.querySelector<HTMLElement>('#error');
  const reset = document.querySelector<HTMLButtonElement>('#reset');
  const copy = document.querySelector<HTMLButtonElement>('#copy');

  const radio = (id: string) => document.querySelector<HTMLInputElement>(id);
  const fmt = (value: number) => formatWon(value);

  const render = () => {
    if (!salary || !taxFree || !dependents || !children) return;
    error!.hidden = true;
    try {
      const result = calculateSalary({
        salary: parseNumber(salary.value),
        salaryType: radio('#salary-type-monthly')?.checked
          ? 'monthly'
          : 'annual',
        retirementType: radio('#retirement-included')?.checked
          ? 'included'
          : 'separate',
        taxFreeMonthly: parseNumber(taxFree.value),
        dependents: parseNumber(dependents.value),
        children8To20: parseNumber(children.value),
      });

      takeHome!.textContent = fmt(result.monthlyTakeHome);
      monthly!.textContent = fmt(result.monthlyGross);
      annualTakeHome!.textContent = fmt(result.annualTakeHome);

      const estimatedHourlyWage = result.monthlyGross / 209;
      const estimatedDailyWage8h = estimatedHourlyWage * 8;
      hourlyWage!.textContent = fmt(estimatedHourlyWage);
      dailyWage8h!.textContent = fmt(estimatedDailyWage8h);
      pension!.textContent = fmt(result.nationalPension);
      health!.textContent = fmt(result.healthInsurance);
      care!.textContent = fmt(result.longTermCare);
      employment!.textContent = fmt(result.employmentInsurance);
      incomeTax!.textContent = fmt(result.incomeTax);
      localTax!.textContent = fmt(result.localIncomeTax);
      totalDeductions!.textContent = fmt(result.totalDeductions);
    } catch (e) {
      error!.textContent =
        e instanceof Error ? e.message : '계산 중 오류가 발생했습니다.';
      error!.hidden = false;
    }
  };

  const syncSalaryType = () => {
    const monthlyMode = radio('#salary-type-monthly')?.checked ?? false;
    if (salary) {
      salary.dataset.step = monthlyMode ? '10000' : '100000';
      salary.value = monthlyMode ? '3,333,333' : '40,000,000';
    }
    render();
  };

  const setSelectedStyles = () => {
    const pairs = [
      ['#salary-type-annual', '#salary-type-annual-label'],
      ['#salary-type-monthly', '#salary-type-monthly-label'],
      ['#retirement-separate', '#retirement-separate-label'],
      ['#retirement-included', '#retirement-included-label'],
    ];
    pairs.forEach(([input, label]) => {
      const checked = document.querySelector<HTMLInputElement>(input)?.checked;
      const el = document.querySelector<HTMLElement>(label);
      if (el) {
        el.classList.toggle('bg-primary', !!checked);
        el.classList.toggle('text-white', !!checked);
        el.classList.toggle('border-primary', !!checked);
        el.classList.toggle('bg-surface', !checked);
        el.classList.toggle('dark:bg-dark-surface-muted', !checked);
      }
    });
  };

  if (form && salary && taxFree && dependents && children && reset && copy) {
    document
      .querySelectorAll<HTMLInputElement>('input[name="salaryType"]')
      .forEach((input) => {
        input.addEventListener('change', () => {
          syncSalaryType();
          setSelectedStyles();
        });
      });
    document
      .querySelectorAll<HTMLInputElement>('input[name="retirement"]')
      .forEach((input) => {
        input.addEventListener('change', () => {
          render();
          setSelectedStyles();
        });
      });


    form.addEventListener('submit', (event) => {
      event.preventDefault();
      render();
    });

    reset.addEventListener('click', () => {
      radio('#salary-type-annual')!.checked = true;
      radio('#retirement-separate')!.checked = true;
      salary.value = '40,000,000';
      taxFree.value = '200,000';
      dependents.value = '1';
      children.value = '0';
      setSelectedStyles();
      render();
    });

    copy.addEventListener('click', async () => {
      const text = [
        `연봉/월급: ${salary.value}원`,
        `월 실수령액: ${takeHome?.textContent}`,
        `세전 월 급여: ${monthly?.textContent}`,
        `공제액 합계: ${totalDeductions?.textContent}`,
      ].join('\n');
      try {
        await navigator.clipboard.writeText(text);
        copy.textContent = '복사 완료';
        setTimeout(() => (copy.textContent = '결과 복사'), 1000);
      } catch {
        copy.textContent = '복사 실패';
      }
    });

    bindNumberControls(form);
    form.addEventListener('input', render);
    setSelectedStyles();
    render();
  }
</script>
