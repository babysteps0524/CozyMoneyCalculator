---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/common/Header.astro";
import Footer from "../../../components/common/Footer.astro";
---

<BaseLayout title="연봉 계산기 | CozyMoney" description="연봉과 월 근로시간을 입력해 예상 월 급여와 시급을 계산할 수 있습니다." canonical="https://cozymoney.kr/calculators/salary/">
  <Header />
  <main class="cm-container" py="8 md:12 lg:16">
    <div max-w="5xl" mx="auto">
      <nav mb="5" text="xs sm:sm" text-text-muted dark="text-dark-text-muted"><a href="/" hover="text-primary" no-underline>홈</a><span mx="2">/</span><a href="/calculators/" hover="text-primary" no-underline>계산기</a><span mx="2">/</span><span>연봉</span></nav>
      <header mb="6 md:8"><p m="0" text="sm" font="700" text-primary>급여 계산기</p><h1 m="0" mt="2" text="3xl md:4xl" font="800">연봉 계산기</h1><p m="0" mt="3" text="sm md:base" leading="7" text-text-muted dark="text-dark-text-muted">세전 연봉과 월 근로시간을 입력해 월 급여와 예상 시급을 확인하세요.</p></header>

      <div grid="~ cols-1 lg:cols-2" gap="4 md:6" items-start>
        <section class="cm-card" p="5 md:7">
          <h2 m="0" text="lg md:xl" font="750">입력 정보</h2>
          <p m="0" mt="1" text="sm" text-text-muted>세전 기준으로 계산합니다.</p>
          <form id="salary-form" mt="6">
            <label class="cm-label" for="annual">연봉</label>
            <div relative><input class="cm-input" id="annual" type="number" inputmode="numeric" min="1" step="100000" value="40000000" pr="12" /><span absolute right-4 top-1/2 translate-y="-1/2" text="sm" text-text-muted>원</span></div>
            <label class="cm-label" for="hours" mt="5">월 근로시간</label>
            <div relative><input class="cm-input" id="hours" type="number" inputmode="decimal" min="1" step="1" value="209" pr="14" /><span absolute right-4 top-1/2 translate-y="-1/2" text="sm" text-text-muted>시간</span></div>
            <div grid="~ cols-1 sm:cols-2" gap="3" mt="6"><button type="submit" class="cm-button-primary" py="3.5">계산하기</button><button id="reset" type="button" class="cm-button-secondary" py="3.5">초기화</button></div>
            <p id="error" hidden m="0" mt="4" rounded="xl" bg="danger-surface" px="4" py="3" text="sm" text-danger-text></p>
          </form>
        </section>

        <section id="result" class="cm-card" p="5 md:7" lg="sticky top-24">
          <div flex="~" items-center justify-between mb="5"><div><p m="0" text="xs" font="700" text-primary>RESULT</p><h2 m="0" mt="1" text="lg md:xl" font="750">계산 결과</h2></div><button id="copy" type="button" class="cm-button-secondary" px="3" py="2" text="xs sm:sm">결과 복사</button></div>
          <div rounded="2xl" bg="primary/10" p="5" dark="bg-[oklch(25%_0.04_250)]"><p m="0" text="sm" text-text-muted>예상 월 급여</p><strong id="monthly" block mt="2" text="2xl md:3xl" font="800" text-primary>-</strong></div>
          <div grid="~ cols-1 sm:cols-2" gap="3" mt="3"><div class="cm-result"><p m="0" text="sm" text-text-muted>예상 시급</p><strong id="hourly" block mt="2" text="lg">-</strong></div><div class="cm-result"><p m="0" text="sm" text-text-muted>8시간 기준 일급</p><strong id="daily" block mt="2" text="lg">-</strong></div></div>
        </section>
      </div>

      <section mt="10 md:14"><h2 class="cm-section-title">계산 기준</h2><div class="cm-card" mt="4" p="5 md:6"><p m="0" text="sm md:base" leading="7" text-text-muted dark="text-dark-text-muted">연봉을 12개월로 나누어 월 급여를 계산하고, 월 급여를 월 근로시간으로 나누어 예상 시급을 계산합니다. 세금과 4대보험 공제 전 금액입니다.</p></div></section>

      <section mt="8 md:10" rounded="2xl" border="1" border-border bg="surface-muted" p="5 md:6" dark="border-dark-border dark:bg-dark-surface-muted">
        <h2 m="0" text="sm" font="750">공통 이용 안내</h2>
        <ul m="0" mt="3" pl="5" text="sm" leading="7" text-text-muted dark="text-dark-text-muted">
          <li>입력값은 이 페이지의 브라우저에서 계산하며 계산기 자체가 별도 저장하지 않습니다.</li>
          <li>연봉을 12개월로 나눈 세전 금액을 기준으로 한 단순 계산입니다.</li>
          <li>소득세, 4대보험, 비과세 항목, 상여금 등 실제 급여 조건은 별도로 확인해야 합니다.</li>
        </ul>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { calculateSalary, formatWon } from "../../../lib/calculators/salary";
  const form=document.querySelector<HTMLFormElement>("#salary-form"), annual=document.querySelector<HTMLInputElement>("#annual"), hours=document.querySelector<HTMLInputElement>("#hours"), monthly=document.querySelector<HTMLElement>("#monthly"), hourly=document.querySelector<HTMLElement>("#hourly"), daily=document.querySelector<HTMLElement>("#daily"), error=document.querySelector<HTMLElement>("#error"), reset=document.querySelector<HTMLButtonElement>("#reset"), copy=document.querySelector<HTMLButtonElement>("#copy");
  const render=()=>{error!.hidden=true;try{const r=calculateSalary({annualSalary:Number(annual!.value),monthlyHours:Number(hours!.value)});monthly!.textContent=formatWon(r.monthlySalary);hourly!.textContent=formatWon(r.hourlyWage);daily!.textContent=formatWon(r.dailyWage);}catch(e){error!.textContent=e instanceof Error?e.message:"계산 중 오류가 발생했습니다.";error!.hidden=false;}};
  if(form&&annual&&hours&&monthly&&hourly&&daily&&error&&reset&&copy){
    form.addEventListener("submit",e=>{e.preventDefault();render();document.querySelector("#result")?.scrollIntoView({behavior:"smooth",block:"start"});});
    reset.addEventListener("click",()=>{annual.value="40000000";hours.value="209";render();});
    copy.addEventListener("click",async()=>{try{await navigator.clipboard.writeText([`연봉: ${Number(annual.value).toLocaleString("ko-KR")}원`,`월 급여: ${monthly.textContent}`,`시급: ${hourly.textContent}`,`일급: ${daily.textContent}`].join("\n"));copy.textContent="복사 완료";setTimeout(()=>copy.textContent="결과 복사",1000);}catch{copy.textContent="복사 실패";}});
    render();
  }
</script>
