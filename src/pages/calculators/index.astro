---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';
import {
  calculatorDefinitions,
  calculatorDirectoryGroups,
} from '../../data/calculators';

const categories = calculatorDirectoryGroups.map((group) => ({
  title: group.title,
  description: group.description,
  items: group.calculatorIds.map((id) => [
    calculatorDefinitions[id].title,
    calculatorDefinitions[id].description,
    `/calculators/${calculatorDefinitions[id].slug}/`,
  ]),
}));
---

<BaseLayout
  title="계산기 | CozyMoney 코지머니"
  description="대출, 예적금, 복리, DSR, DTI, 급여, 세금, 부동산 등 생활에 필요한 계산기를 제공합니다."
  canonical="https://cozymoney.kr/calculators/"
>
  <Header />
  <main class="cm-container" py="10 md:14 lg:18">
    <header max-w="3xl" mb="8 md:10">
      <p m="0" text="sm" font="700" text-primary>
        CALCULATORS
      </p>
      <h1 m="0" mt="2" text="3xl md:4xl" font="800" tracking-tight>
        필요한 계산기를 찾아보세요
      </h1>
      <p
        m="0"
        mt="4"
        text="base md:lg"
        leading="7"
        text-text-muted
        dark="text-dark-text-muted"
      >
        금융, 급여·노동, 세금, 부동산 계산기를 한곳에서 이용할 수 있습니다.
      </p>
    </header>
    <div flex="~ col" gap="10 md:12">
      {categories.map((category) => (
        <section>
          <div mb="4 md:5">
            <h2 m="0" text="xl md:2xl" font="750">
              {category.title}
            </h2>
            <p
              m="0"
              mt="1"
              text="sm"
              text-text-muted
              dark="text-dark-text-muted"
            >
              {category.description}
            </p>
          </div>
          <div grid="~ cols-1 sm:cols-2 lg:cols-3" gap="3 md:4">
            {category.items.map(([title, description, href]) => (
              <a
                href={href}
                class="cm-card-interactive"
                p="5 md:6"
                no-underline
              >
                <div flex="~" items-center justify-between gap="3">
                  <h3
                    m="0"
                    text="lg"
                    font="750"
                    text-text
                    dark="text-dark-text"
                  >
                    {title}
                  </h3>
                  <span text="text-subtle" dark="text-dark-text-subtle">
                    →
                  </span>
                </div>
                <p
                  m="0"
                  mt="2"
                  text="sm"
                  leading="6"
                  text-text-muted
                  dark="text-dark-text-muted"
                >
                  {description}
                </p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
