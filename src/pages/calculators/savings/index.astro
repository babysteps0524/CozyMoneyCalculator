---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/common/Header.astro';
import Footer from '../../../components/common/Footer.astro';
import AdSlot from '../../../components/common/AdSlot.astro';
---

<BaseLayout
  title="예적금 계산기 | CozyMoney 코지머니"
  description="예금과 적금의 예상 만기금액을 계산할 수 있습니다."
  canonical="https://cozymoney.kr/calculators/savings/"
>
  <Header />
  <main class="cm-container" py="8 md:12 lg:16">
    <div max-w="5xl" mx="auto">
      <nav mb="5" text="xs sm:sm" text-text-muted dark="text-dark-text-muted">
        <a href="/" hover="text-primary" no-underline>
          홈
        </a>
        <span mx="2">/</span>
        <a href="/calculators/" hover="text-primary" no-underline>
          계산기
        </a>
        <span mx="2">/</span>
        <span>예적금</span>
      </nav>
      <header mb="6 md:8">
        <p m="0" text="sm" font="700" text-primary>
          저축 계산기
        </p>
        <h1 m="0" mt="2" text="3xl md:4xl" font="800">
          예적금 계산기
        </h1>
        <p
          m="0"
          mt="3"
          text="sm md:base"
          leading="7"
          text-text-muted
          dark="text-dark-text-muted"
        >
          예금과 적금의 금액, 금리, 기간을 입력해 예상 만기금액을 확인하세요.
        </p>
      </header>

      <div grid="~ cols-1 lg:cols-2" gap="4 md:6" items-start>
        <section class="cm-card" p="5 md:7">
          <div
            grid="~ cols-2"
            gap="2"
            p="1"
            rounded="xl"
            bg="surface-subtle"
            dark="bg-dark-surface-subtle"
          >
            <button
              id="deposit-tab"
              type="button"
              role="tab"
              aria-pressed="true"
            >
              예금
            </button>
            <button
              id="installment-tab"
              type="button"
              role="tab"
              aria-pressed="false"
            >
              적금
            </button>
          </div>

          <form id="savings-form" mt="6">
            <div id="deposit-field">
              <label class="cm-label" for="principal">
                예치금액
              </label>
              <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
                <button
                  type="button"
                  data-step-direction="-1"
                  aria-label="예치금액 감소"
                  class="cm-step-button"
                >
                  −
                </button>
                <input
                  class="cm-input"
                  id="principal"
                  type="text"
                  inputmode="numeric"
                  value="10000000"
                  data-number-input
                  data-step="100000"
                  data-min="1"
                  data-decimal="false"
                />
                <button
                  type="button"
                  data-step-direction="1"
                  aria-label="예치금액 증가"
                  class="cm-step-button"
                >
                  +
                </button>
              </div>
            </div>
            <div id="monthly-field" hidden>
              <label class="cm-label" for="monthly">
                월 납입금액
              </label>
              <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
                <button
                  type="button"
                  data-step-direction="-1"
                  aria-label="월 납입금액 감소"
                  class="cm-step-button"
                >
                  −
                </button>
                <input
                  class="cm-input"
                  id="monthly"
                  type="text"
                  inputmode="numeric"
                  value="300000"
                  data-number-input
                  data-step="10000"
                  data-min="1"
                  data-decimal="false"
                />
                <button
                  type="button"
                  data-step-direction="1"
                  aria-label="월 납입금액 증가"
                  class="cm-step-button"
                >
                  +
                </button>
              </div>
            </div>
            <div mt="5">
              <label class="cm-label" for="rate">
                연이율
              </label>
              <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
                <button
                  type="button"
                  data-step-direction="-1"
                  aria-label="연이율 감소"
                  class="cm-step-button"
                >
                  −
                </button>
                <div relative>
                  <input
                    class="cm-input"
                    id="rate"
                    type="text"
                    inputmode="decimal"
                    value="3.5"
                    data-number-input
                    data-step="0.1"
                    data-min="0"
                    data-decimal="true"
                    pr="12"
                  />
                  <span
                    absolute
                    right-4
                    top="[50%]"
                    translate-y="[-50%]"
                    text="sm"
                    text-text-muted
                  >
                    {' '}
                    %{' '}
                  </span>
                </div>
                <button
                  type="button"
                  data-step-direction="1"
                  aria-label="연이율 증가"
                  class="cm-step-button"
                >
                  +
                </button>
              </div>
            </div>
            <div mt="5">
              <label class="cm-label" for="months">
                저축기간
              </label>
              <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
                <button
                  type="button"
                  data-step-direction="-1"
                  aria-label="저축기간 감소"
                  class="cm-step-button"
                >
                  −
                </button>
                <div relative>
                  <input
                    class="cm-input"
                    id="months"
                    type="text"
                    inputmode="numeric"
                    value="12"
                    data-number-input
                    data-step="1"
                    data-min="1"
                    data-decimal="false"
                    pr="14"
                  />
                  <span
                    absolute
                    right-4
                    top="[50%]"
                    translate-y="[-50%]"
                    text="sm"
                    text-text-muted
                  >
                    개월
                  </span>
                </div>
                <button
                  type="button"
                  data-step-direction="1"
                  aria-label="저축기간 증가"
                  class="cm-step-button"
                >
                  +
                </button>
              </div>
            </div>
            <div grid="~ cols-1 sm:cols-2" gap="3" mt="6">
              <button type="submit" class="cm-button-primary" py="3.5">
                계산하기
              </button>
              <button
                id="reset"
                type="button"
                class="cm-button-secondary"
                py="3.5"
              >
                초기화
              </button>
            </div>
            <p
              id="error"
              hidden
              m="0"
              mt="4"
              rounded="xl"
              bg="danger-surface"
              dark="bg-dark-danger-surface"
              px="4"
              py="3"
              text="sm"
              text-danger-text
              dark="text-dark-danger-text"
            ></p>
          </form>
        </section>

        <section id="result" class="cm-card" p="5 md:7" lg="sticky top-24">
          <div flex="~" items-center justify-between mb="5">
            <div>
              <p m="0" text="xs" font="700" text-primary>
                RESULT
              </p>
              <h2 m="0" mt="1" text="lg md:xl" font="750">
                예상 만기 결과
              </h2>
            </div>
            <button
              id="copy"
              type="button"
              class="cm-button-secondary"
              px="3"
              py="2"
              text="xs sm:sm"
            >
              결과 복사
            </button>
          </div>
          <div
            rounded="2xl"
            bg="primary/10"
            p="5"
            dark="bg-dark-primary-surface"
          >
            <p m="0" text="sm" text-text-muted dark="text-dark-text-muted">
              세후 예상 만기금액
            </p>
            <strong
              id="maturity"
              block
              mt="2"
              text="2xl md:3xl"
              font="800"
              text-primary
            >
              -
            </strong>
          </div>
          <div grid="~ cols-1 sm:cols-2" gap="3" mt="3">
            <div class="cm-result">
              <p m="0" text="sm" text-text-muted>
                납입 원금
              </p>
              <strong id="paid" block mt="2" text="lg">
                -
              </strong>
            </div>
            <div class="cm-result">
              <p m="0" text="sm" text-text-muted>
                세전 이자
              </p>
              <strong id="interest" block mt="2" text="lg">
                -
              </strong>
            </div>
            <div class="cm-result" sm="col-span-2">
              <p m="0" text="sm" text-text-muted>
                이자소득세(15.4% 가정)
              </p>
              <strong id="tax" block mt="2" text="lg">
                -
              </strong>
            </div>
          </div>
        </section>
      </div>

      <AdSlot slot={import.meta.env.PUBLIC_ADSENSE_SLOT_CALCULATOR || ''} />

      <section mt="10 md:14">
        <h2 class="cm-section-title">예적금 계산 방법</h2>
        <div grid="~ cols-1 lg:cols-3" gap="4" mt="4">
          <div class="cm-card" p="5">
            <h3 m="0" font="750">
              예금
            </h3>
            <p
              m="0"
              mt="3"
              text="sm"
              leading="7"
              text-text-muted
              dark="text-dark-text-muted"
            >
              예치한 원금에 연이율과 가입기간을 적용해 세전 이자를 계산합니다.
              실제 상품의 이자 지급방식에 따라 결과가 달라질 수 있습니다.
            </p>
          </div>
          <div class="cm-card" p="5">
            <h3 m="0" font="750">
              적금
            </h3>
            <p
              m="0"
              mt="3"
              text="sm"
              leading="7"
              text-text-muted
              dark="text-dark-text-muted"
            >
              매월 납입한 금액이 납입시점에 따라 서로 다른 기간 동안 이자를
              받는다고 가정합니다. 따라서 같은 연이율이라도 예금과 적금의 이자는
              다릅니다.
            </p>
          </div>
          <div class="cm-card" p="5">
            <h3 m="0" font="750">
              세후 금액
            </h3>
            <p
              m="0"
              mt="3"
              text="sm"
              leading="7"
              text-text-muted
              dark="text-dark-text-muted"
            >
              현재 계산기는 세전 이자에 15.4%를 단순 적용해 세금을 표시합니다.
              비과세·세금우대 상품이나 개인별 과세조건은 별도입니다.
            </p>
          </div>
        </div>
      </section>
      <section
        mt="6"
        rounded="2xl"
        border="1"
        border-border
        bg="surface-muted"
        p="5 md:6"
        dark="border-dark-border bg-dark-surface-muted"
      >
        <h2 m="0" font="750" dark="text-dark-text">
          공식 기준과 주의사항
        </h2>
        <ul
          m="0"
          mt="3"
          pl="5"
          text="sm"
          leading="7"
          text-text-muted
          dark="text-dark-text-muted"
        >
          <li>
            예금·적금의 실제 이자는 상품 약관에 정한 이율, 이자계산기간, 납입일
            등을 기준으로 금융기관이 산정합니다.
          </li>
          <li>
            우대금리 조건을 충족하지 못하면 실제 이율이 낮아질 수 있습니다.
          </li>
          <li>
            중도해지 시 약정금리와 다른 중도해지 이율이 적용될 수 있습니다.
          </li>
          <li>
            예금자보호 여부와 보호한도는 금융상품 가입 전 금융기관의 최신 안내를
            확인하세요.
          </li>
        </ul>
      </section>

      <section
        mt="8 md:10"
        rounded="2xl"
        border="1"
        border-border
        bg="surface-muted"
        p="5 md:6"
        dark="border-dark-border bg-dark-surface-muted"
      >
        <h2 m="0" text="sm" font="750" dark="text-dark-text">
          공통 이용 안내
        </h2>
        <ul
          m="0"
          mt="3"
          pl="5"
          text="sm"
          leading="7"
          text-text-muted
          dark="text-dark-text-muted"
        >
          <li>
            입력값은 이 페이지의 브라우저에서 계산하며 계산기 자체가 별도
            저장하지 않습니다.
          </li>
          <li>
            세후 결과는 안내된 세율을 단순 적용한 참고값이며 실제 세금과 다를 수
            있습니다.
          </li>
          <li>
            금융기관별 우대금리, 중도해지, 상품별 조건은 계산에 모두 반영되지
            않을 수 있습니다.
          </li>
        </ul>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import {
    calculateSavings,
    formatWon,
    type SavingsType,
  } from '../../../lib/calculators/savings';
  import {
    bindNumberControls,
    parseNumber,
  } from '../../../lib/calculators/number-input';
  const form = document.querySelector<HTMLFormElement>('#savings-form');
  const depositTab = document.querySelector<HTMLButtonElement>('#deposit-tab');
  const installmentTab =
    document.querySelector<HTMLButtonElement>('#installment-tab');
  const depositField = document.querySelector<HTMLElement>('#deposit-field');
  const monthlyField = document.querySelector<HTMLElement>('#monthly-field');
  const principal = document.querySelector<HTMLInputElement>('#principal');
  const monthly = document.querySelector<HTMLInputElement>('#monthly');
  const rate = document.querySelector<HTMLInputElement>('#rate');
  const months = document.querySelector<HTMLInputElement>('#months');
  const maturity = document.querySelector<HTMLElement>('#maturity');
  const paid = document.querySelector<HTMLElement>('#paid');
  const interest = document.querySelector<HTMLElement>('#interest');
  const tax = document.querySelector<HTMLElement>('#tax');
  const error = document.querySelector<HTMLElement>('#error');
  const reset = document.querySelector<HTMLButtonElement>('#reset');
  const copy = document.querySelector<HTMLButtonElement>('#copy');
  let type: SavingsType = 'deposit';

  const setType = (next: SavingsType) => {
    type = next;
    depositField!.hidden = type !== 'deposit';
    monthlyField!.hidden = type !== 'installment';
    const depositActive = type === 'deposit';
    depositTab!.setAttribute('aria-pressed', String(depositActive));
    installmentTab!.setAttribute('aria-pressed', String(!depositActive));

    const baseTabClass =
      'cm-button rounded-lg py-2.5 text-sm font-700 transition-colors duration-100';
    const activeTabClass = 'bg-primary text-white hover:bg-primary';
    const inactiveTabClass =
      'bg-transparent text-text-muted dark:text-dark-text-muted hover:bg-surface hover:text-text dark:hover:bg-dark-surface dark:hover:text-dark-text';

    depositTab!.className =
      baseTabClass + ' ' + (depositActive ? activeTabClass : inactiveTabClass);
    installmentTab!.className =
      baseTabClass + ' ' + (!depositActive ? activeTabClass : inactiveTabClass);
    render();
  };
  const render = () => {
    error!.hidden = true;
    try {
      const r = calculateSavings({
        type,
        principal: parseNumber(principal!.value),
        monthlyDeposit: parseNumber(monthly!.value),
        annualRate: parseNumber(rate!.value),
        months: parseNumber(months!.value),
      });
      maturity!.textContent = formatWon(r.maturityAmount);
      paid!.textContent = formatWon(r.principal);
      interest!.textContent = formatWon(r.interestBeforeTax);
      tax!.textContent = formatWon(r.tax);
    } catch (e) {
      error!.textContent =
        e instanceof Error ? e.message : '계산 중 오류가 발생했습니다.';
      error!.hidden = false;
    }
  };
  if (
    form &&
    depositTab &&
    installmentTab &&
    depositField &&
    monthlyField &&
    principal &&
    monthly &&
    rate &&
    months &&
    maturity &&
    paid &&
    interest &&
    tax &&
    error &&
    reset &&
    copy
  ) {
    depositTab.addEventListener('click', () => setType('deposit'));
    installmentTab.addEventListener('click', () => setType('installment'));
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      render();
    });
    reset.addEventListener('click', () => {
      type = 'deposit';
      principal.value = '10,000,000';
      monthly.value = '300,000';
      rate.value = '3.5';
      months.value = '12';
      setType('deposit');
    });
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(
          [
            `유형: ${type === 'deposit' ? '예금' : '적금'}`,
            `납입 원금: ${paid.textContent}`,
            `세전 이자: ${interest.textContent}`,
            `세금: ${tax.textContent}`,
            `세후 만기금액: ${maturity.textContent}`,
          ].join('\n'),
        );
        copy.textContent = '복사 완료';
        setTimeout(() => (copy.textContent = '결과 복사'), 1000);
      } catch {
        copy.textContent = '복사 실패';
      }
    });
    bindNumberControls(form);
    setType(type);
  }
</script>
