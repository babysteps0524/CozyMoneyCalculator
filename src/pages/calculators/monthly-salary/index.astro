---
import CalculatorPage from '../../../components/calculators/CalculatorPage.astro';
import { calculatorDefinitions } from '../../../data/calculators';

const definition = calculatorDefinitions.monthly-salary;
import AdSlot from '../../../components/common/AdSlot.astro';
---

<CalculatorPage definition={definition}>
  <main class="cm-container" py="8 md:12 lg:16">
    <div max-w="5xl" mx="auto">
      <nav mb="5" text="xs sm:sm" text-text-muted dark="text-dark-text-muted">
        <a href="/" hover="text-primary" no-underline>
          홈
        </a>
        <span mx="2">/</span>
        <a href="/calculators/" hover="text-primary" no-underline>
          계산기
        </a>
        <span mx="2">/</span>
        <span>급여·노동</span>
      </nav>

      <header mb="6 md:8">
        <p m="0" text="sm" font="700" text-primary>
          급여·노동
        </p>
        <h1 m="0" mt="2" text="3xl md:4xl" font="800">
          월급 계산기
        </h1>
        <p
          m="0"
          mt="3"
          text="sm md:base"
          leading="7"
          text-text-muted
          dark="text-dark-text-muted"
        >
          월급과 비과세액, 부양가족, 20세 이하 자녀 수를 입력해 예상 공제액과 월
          실수령액을 확인하세요.
        </p>
      </header>

      <div grid="~ cols-1 lg:cols-2" gap="4 md:6" items-start>
        <section class="cm-card" p="5 md:7">
          <h2 m="0" text="lg md:xl" font="750">
            월급 입력
          </h2>
          <p
            m="0"
            mt="1"
            text="sm"
            leading="6"
            text-text-muted
            dark="text-dark-text-muted"
          >
            급여명세서의 월 세전 급여와 비과세 항목을 기준으로 입력하면 됩니다.
          </p>

          <form id="monthly-salary-form" mt="6">
            <label class="cm-label" for="salary">
              월급(세전)
            </label>
            <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
              <button
                type="button"
                data-step-direction="-1"
                aria-label="월급 감소"
                class="cm-step-button"
              >
                −
              </button>
              <div relative>
                <input
                  class="cm-input"
                  id="salary"
                  type="text"
                  inputmode="numeric"
                  value="3,333,333"
                  data-number-input
                  data-step="10000"
                  data-min="1"
                  data-decimal="false"
                  pr="12"
                />
                <span
                  absolute
                  right-4
                  top="[50%]"
                  translate-y="[-50%]"
                  text="sm"
                  text-text-muted
                  dark="text-dark-text-muted"
                >
                  원
                </span>
              </div>
              <button
                type="button"
                data-step-direction="1"
                aria-label="월급 증가"
                class="cm-step-button"
              >
                +
              </button>
            </div>

            <label class="cm-label" for="tax-free" mt="5">
              비과세액(월, 식대 포함)
            </label>
            <div grid="~ cols-[auto_minmax(0,1fr)_auto]" items-center gap="2">
              <button
                type="button"
                data-step-direction="-1"
                aria-label="비과세액 감소"
                class="cm-step-button"
              >
                −
              </button>
              <div relative>
                <input
                  class="cm-input"
                  id="tax-free"
                  type="text"
                  inputmode="numeric"
                  value="200,000"
                  data-number-input
                  data-step="10000"
                  data-min="0"
                  data-decimal="false"
                  pr="12"
                />
                <span
                  absolute
                  right-4
                  top="[50%]"
                  translate-y="[-50%]"
                  text="sm"
                  text-text-muted
                  dark="text-dark-text-muted"
                >
                  원
                </span>
              </div>
              <button
                type="button"
                data-step-direction="1"
                aria-label="비과세액 증가"
                class="cm-step-button"
              >
                +
              </button>
            </div>
            <p
              m="0"
              mt="2"
              text="xs"
              leading="6"
              text-text-subtle
              dark="text-dark-text-subtle"
            >
              비과세액은 과세 대상 월급에서 제외되는 금액입니다. 식대 등 항목별
              비과세 요건과 한도는 실제 급여조건을 확인하세요.
            </p>

            <div grid="~ cols-1 sm:cols-2" gap="3" mt="5">
              <div>
                <label class="cm-label" for="dependents">
                  부양가족 수(본인 포함)
                </label>
                <div
                  grid="~ cols-[auto_minmax(0,1fr)_auto]"
                  items-center
                  gap="2"
                >
                  <button
                    type="button"
                    data-step-direction="-1"
                    aria-label="부양가족 감소"
                    class="cm-step-button"
                  >
                    −
                  </button>
                  <input
                    class="cm-input"
                    id="dependents"
                    type="text"
                    inputmode="numeric"
                    value="1"
                    data-number-input
                    data-step="1"
                    data-min="1"
                    data-decimal="false"
                    text="center"
                  />
                  <button
                    type="button"
                    data-step-direction="1"
                    aria-label="부양가족 증가"
                    class="cm-step-button"
                  >
                    +
                  </button>
                </div>
              </div>
              <div>
                <label class="cm-label" for="children">
                  20세 이하 자녀 수
                </label>
                <div
                  grid="~ cols-[auto_minmax(0,1fr)_auto]"
                  items-center
                  gap="2"
                >
                  <button
                    type="button"
                    data-control="children"
                    data-step="-1"
                    aria-label="자녀 수 감소"
                    class="cm-step-button"
                  >
                    −
                  </button>
                  <input
                    class="cm-input"
                    id="children"
                    type="text"
                    inputmode="numeric"
                    value="0"
                    data-number-input
                    data-step="1"
                    data-min="0"
                    data-decimal="false"
                    text="center"
                  />
                  <button
                    type="button"
                    data-control="children"
                    data-step="1"
                    aria-label="자녀 수 증가"
                    class="cm-step-button"
                  >
                    +
                  </button>
                </div>
              </div>
            </div>

            <fieldset mt="5" border="0" p="0">
              <legend class="cm-label">만 60세 이상 근로자</legend>
              <div grid="~ cols-2" gap="2">
                <label>
                  <input
                    id="under-60"
                    type="radio"
                    name="age60"
                    value="no"
                    checked
                    sr-only
                  />
                  <span
                    id="under-60-label"
                    class="cm-button-secondary"
                    block
                    py="2.5"
                    text="center sm"
                  >
                    아니오
                  </span>
                </label>
                <label>
                  <input
                    id="age-60"
                    type="radio"
                    name="age60"
                    value="yes"
                    sr-only
                  />
                  <span
                    id="age-60-label"
                    class="cm-button-secondary"
                    block
                    py="2.5"
                    text="center sm"
                  >
                    예
                  </span>
                </label>
              </div>
              <p
                m="0"
                mt="2"
                text="xs"
                leading="6"
                text-text-subtle
                dark="text-dark-text-subtle"
              >
                만 60세 이상을 선택하면 국민연금 근로자 부담액을 0원으로
                계산합니다.
              </p>
            </fieldset>

            <div grid="~ cols-1 sm:cols-2" gap="3" mt="6">
              <button type="submit" class="cm-button-primary" py="3.5">
                계산하기
              </button>
              <button
                id="reset"
                type="button"
                class="cm-button-secondary"
                py="3.5"
              >
                초기화
              </button>
            </div>
            <p
              id="error"
              hidden
              m="0"
              mt="4"
              rounded="xl"
              bg="danger-surface"
              dark="bg-dark-danger-surface"
              px="4"
              py="3"
              text="sm"
              text-danger-text
              dark="text-dark-danger-text"
            ></p>
          </form>
        </section>

        <section id="result" class="cm-card" aria-live="polite" aria-atomic="true" p="5 md:7" lg="sticky top-24">
          <div flex="~" items-center justify-between gap="3" mb="5">
            <div>
              <p m="0" text="xs" font="700" text-primary>
                RESULT
              </p>
              <h2 m="0" mt="1" text="lg md:xl" font="750">
                예상 실수령액
              </h2>
            </div>
            <button
              id="copy"
              type="button"
              class="cm-button-secondary"
              px="3"
              py="2"
              text="xs sm:sm"
            >
              결과 복사
            </button>
          </div>

          <div
            rounded="2xl"
            bg="primary/10"
            p="5"
            dark="bg-dark-primary-surface"
          >
            <p m="0" text="sm" text-text-muted dark="text-dark-text-muted">
              월 예상 실수령액
            </p>
            <strong
              id="take-home"
              block
              mt="2"
              text="2xl md:3xl"
              font="800"
              text-primary
            >
              -
            </strong>
          </div>

          <div grid="~ cols-2" gap="3" mt="3">
            <div class="cm-result">
              <p m="0" text="sm" text-text-muted dark="text-dark-text-muted">
                세전 월급
              </p>
              <strong id="gross" block mt="2" text="lg">
                -
              </strong>
            </div>
            <div class="cm-result">
              <p m="0" text="sm" text-text-muted dark="text-dark-text-muted">
                과세 대상 월급
              </p>
              <strong id="taxable" block mt="2" text="lg">
                -
              </strong>
            </div>
          </div>

          <div grid="~ cols-2" gap="3" mt="3">
            <div class="cm-result">
              <p m="0" text="sm" text-text-muted dark="text-dark-text-muted">
                1일 8시간 기준 일급
              </p>
              <strong id="daily-wage" block mt="2" text="lg">
                -
              </strong>
            </div>
            <div class="cm-result">
              <p m="0" text="sm" text-text-muted dark="text-dark-text-muted">
                예상 시급
              </p>
              <strong id="hourly-wage" block mt="2" text="lg">
                -
              </strong>
            </div>
          </div>

          <div
            mt="3"
            rounded="xl"
            border="1"
            border-border
            p="4"
            dark="border-dark-border"
          >
            <div flex="~" justify-between gap="3" text="sm">
              <span>국민연금</span>
              <strong id="pension">-</strong>
            </div>
            <div flex="~" justify-between gap="3" mt="2" text="sm">
              <span>건강보험</span>
              <strong id="health">-</strong>
            </div>
            <div flex="~" justify-between gap="3" mt="2" text="sm">
              <span>장기요양</span>
              <strong id="care">-</strong>
            </div>
            <div flex="~" justify-between gap="3" mt="2" text="sm">
              <span>고용보험</span>
              <strong id="employment">-</strong>
            </div>
            <div flex="~" justify-between gap="3" mt="2" text="sm">
              <span>소득세(추정)</span>
              <strong id="income-tax">-</strong>
            </div>
            <div flex="~" justify-between gap="3" mt="2" text="sm">
              <span>지방소득세</span>
              <strong id="local-tax">-</strong>
            </div>
            <div
              flex="~"
              justify-between
              gap="3"
              mt="3"
              pt="3"
              border-t="1"
              border-border
              font="750"
              dark="border-dark-border"
            >
              <span>공제액 합계</span>
              <strong id="total-deductions">-</strong>
            </div>
          </div>

          <p
            m="0"
            mt="4"
            text="xs"
            leading="6"
            text-text-subtle
            dark="text-dark-text-subtle"
          >
            실제 급여명세서와 세법·보험료 산정기준에 따라 결과가 달라질 수 있는
            참고용 계산입니다.
          </p>
        </section>
      </div>

      <AdSlot slot={import.meta.env.PUBLIC_ADSENSE_SLOT_CALCULATOR || ''} />

      <section mt="10 md:14">
        <h2 class="cm-section-title">월급 계산기는 어떻게 계산하나요?</h2>
        <div grid="~ cols-1 lg:cols-2" gap="4" mt="4">
          <div class="cm-card" p="5">
            <h3 m="0" font="750">
              1. 비과세액을 제외한 과세 대상 급여
            </h3>
            <p
              m="0"
              mt="3"
              text="sm"
              leading="7"
              text-text-muted
              dark="text-dark-text-muted"
            >
              입력한 세전 월급에서 비과세액을 차감해 4대보험과 소득세 추정의
              기준이 되는 과세 대상 월급을 구합니다.
            </p>
          </div>
          <div class="cm-card" p="5">
            <h3 m="0" font="750">
              2. 사회보험료와 세금 공제
            </h3>
            <p
              m="0"
              mt="3"
              text="sm"
              leading="7"
              text-text-muted
              dark="text-dark-text-muted"
            >
              국민연금, 건강보험, 장기요양보험, 고용보험과 소득세·지방소득세를
              각각 계산해 공제액을 합산합니다.
            </p>
          </div>
          <div class="cm-card" p="5">
            <h3 m="0" font="750">
              3. 부양가족과 자녀 수 반영
            </h3>
            <p
              m="0"
              mt="3"
              text="sm"
              leading="7"
              text-text-muted
              dark="text-dark-text-muted"
            >
              본인을 포함한 부양가족 수와 20세 이하 자녀 수를 소득세 추정에
              반영합니다.
            </p>
          </div>
          <div class="cm-card" p="5">
            <h3 m="0" font="750">
              4. 실수령액 확인
            </h3>
            <p
              m="0"
              mt="3"
              text="sm"
              leading="7"
              text-text-muted
              dark="text-dark-text-muted"
            >
              세전 월급에서 각 공제액을 차감한 금액을 월 예상 실수령액으로
              표시합니다.
            </p>
          </div>
        </div>
      </section>

      <section
        mt="6"
        rounded="2xl"
        border="1"
        border-border
        bg="surface-muted"
        p="5 md:6"
        dark="border-dark-border bg-dark-surface-muted"
      >
        <h2 m="0" font="750" dark="text-dark-text">
          계산 예시
        </h2>
        <p
          m="0"
          mt="3"
          text="sm"
          leading="7"
          text-text-muted
          dark="text-dark-text-muted"
        >
          예를 들어 월급 3,333,333원, 비과세액 200,000원, 부양가족 1명, 20세
          이하 자녀 0명으로 입력하면 과세 대상 월급은 3,133,333원으로
          계산됩니다. 이후 사회보험료와 소득세 추정액을 차감해 실수령액을
          산출합니다. 정확한 결과는 계산기에 같은 값을 직접 입력해 확인할 수
          있습니다.
        </p>
      </section>

      <section
        mt="6"
        rounded="2xl"
        border="1"
        border="danger/20"
        bg="danger-surface"
        p="5 md:6"
        dark="border-dark-border bg-dark-danger-surface"
      >
        <h2 m="0" font="750" dark="text-dark-text">
          주의사항
        </h2>
        <ul
          m="0"
          mt="3"
          pl="5"
          text="sm"
          leading="7"
          text-text-muted
          dark="text-dark-text-muted"
        >
          <li>
            비과세 항목은 급여의 명칭만으로 결정되지 않으며 실제 지급요건과 관련
            세법상 요건을 확인해야 합니다.
          </li>
          <li>
            소득세는 국세청 근로소득 간이세액표와 동일한 원천징수액을 보장하지
            않는 참고용 추정입니다.
          </li>
          <li>
            국민연금은 만 60세 이상 여부에 따라 적용이 달라질 수 있으며, 이
            계산기는 만 60세 이상을 선택하면 근로자 국민연금을 제외합니다.
          </li>
          <li>
            중도입사·퇴사, 상여금, 수당, 연말정산, 실제 보험료 부과기준에 따라
            급여명세서의 금액과 차이가 날 수 있습니다.
          </li>
          <li>
            급여·세금 관련 중요한 판단은 회사 급여담당자와 국세청 등 공식 기준을
            함께 확인하세요.
          </li>
        </ul>
      </section>

      <section
        mt="8"
        rounded="2xl"
        border="1"
        border-border
        bg="surface-muted"
        p="5 md:6"
        dark="border-dark-border bg-dark-surface-muted"
      >
        <h2 m="0" text="lg" font="750">
          자주 묻는 질문
        </h2>
        <div mt="4" grid="~ cols-1" gap="4">
          <div>
            <h3 m="0" text="sm" font="750">
              비과세액을 꼭 입력해야 하나요?
            </h3>
            <p
              m="0"
              mt="2"
              text="sm"
              leading="7"
              text-text-muted
              dark="text-dark-text-muted"
            >
              아니요. 비과세액이 없다면 0원을 입력하면 됩니다. 식대 등 실제
              비과세 급여가 있다면 회사 급여명세서와 적용요건을 확인해
              입력하세요.
            </p>
          </div>
          <div>
            <h3 m="0" text="sm" font="750">
              부양가족 수는 왜 필요한가요?
            </h3>
            <p
              m="0"
              mt="2"
              text="sm"
              leading="7"
              text-text-muted
              dark="text-dark-text-muted"
            >
              근로소득 원천징수에서 공제대상 가족 수가 소득세 산정에 영향을 줄
              수 있기 때문입니다. 계산기에서는 본인을 포함한 부양가족 수를
              입력합니다.
            </p>
          </div>
          <div>
            <h3 m="0" text="sm" font="750">
              실제 월급과 왜 다를 수 있나요?
            </h3>
            <p
              m="0"
              mt="2"
              text="sm"
              leading="7"
              text-text-muted
              dark="text-dark-text-muted"
            >
              급여 항목, 비과세 인정범위, 보험료 기준소득월액, 원천징수 방식,
              중도입사·퇴사와 연말정산 등에 따라 실제 금액이 달라질 수 있습니다.
            </p>
          </div>
        </div>
      </section>

      <section
        mt="6"
        rounded="2xl"
        border="1"
        border-border
        bg="surface-muted"
        p="5 md:6"
        dark="border-dark-border bg-dark-surface-muted"
      >
        <h2 m="0" text="sm" font="750">
          공식 기준 및 관련 계산기
        </h2>
        <ul
          m="0"
          mt="3"
          pl="5"
          text="sm"
          leading="7"
          text-text-muted
          dark="text-dark-text-muted"
        >
          <li>
            <a href="/calculators/salary/" hover="text-primary" underline>
              연봉 계산기
            </a>
            에서 연봉과 퇴직금 포함 여부를 기준으로 확인할 수 있습니다.
          </li>
          <li>
            <a href="/calculators/hourly-wage/" hover="text-primary" underline>
              시급 계산기
            </a>
            에서 시급·일급·주급·월급을 근무시간 기준으로 환산할 수 있습니다.
          </li>
          <li>
            소득세 원천징수는 국세청의 근로소득 간이세액표 등 최신 공식 기준을
            확인하는 것이 좋습니다.
          </li>
          <li>
            국민연금·건강보험 등 사회보험료는 각 기관의 최신 보험료 부과기준을
            확인하세요.
          </li>
        </ul>
      </section>
    </div>
  </main>
</CalculatorPage>

<script>
  import { calculateSalary, formatWon } from '../../../lib/calculators/salary';
  import {
    bindNumberControls,
    parseNumber,
  } from '../../../lib/calculators/number-input';
  import { bindLiveCalculation } from '../../../lib/calculators/runtime';

  const form = document.querySelector<HTMLFormElement>('#monthly-salary-form');
  const salary = document.querySelector<HTMLInputElement>('#salary');
  const taxFree = document.querySelector<HTMLInputElement>('#tax-free');
  const dependents = document.querySelector<HTMLInputElement>('#dependents');
  const children = document.querySelector<HTMLInputElement>('#children');
  const takeHome = document.querySelector<HTMLElement>('#take-home');
  const gross = document.querySelector<HTMLElement>('#gross');
  const taxable = document.querySelector<HTMLElement>('#taxable');
  const dailyWage = document.querySelector<HTMLElement>('#daily-wage');
  const hourlyWage = document.querySelector<HTMLElement>('#hourly-wage');
  const pension = document.querySelector<HTMLElement>('#pension');
  const health = document.querySelector<HTMLElement>('#health');
  const care = document.querySelector<HTMLElement>('#care');
  const employment = document.querySelector<HTMLElement>('#employment');
  const incomeTax = document.querySelector<HTMLElement>('#income-tax');
  const localTax = document.querySelector<HTMLElement>('#local-tax');
  const totalDeductions =
    document.querySelector<HTMLElement>('#total-deductions');
  const error = document.querySelector<HTMLElement>('#error');
  const reset = document.querySelector<HTMLButtonElement>('#reset');
  const copy = document.querySelector<HTMLButtonElement>('#copy');

  const radio = (id: string) => document.querySelector<HTMLInputElement>(id);
  const fmt = (value: number) => formatWon(value);

  const render = () => {
    if (!salary || !taxFree || !dependents || !children) return;
    error!.hidden = true;

    try {
      const result = calculateSalary({
        salary: parseNumber(salary.value),
        salaryType: 'monthly',
        retirementType: 'separate',
        taxFreeMonthly: parseNumber(taxFree.value),
        dependents: parseNumber(dependents.value),
        children8To20: parseNumber(children.value),
        age60OrOlder: radio('#age-60')?.checked ?? false,
      });

      takeHome!.textContent = fmt(result.monthlyTakeHome);
      gross!.textContent = fmt(result.monthlyGross);
      taxable!.textContent = fmt(result.taxableMonthly);

      const estimatedHourlyWage = result.monthlyGross / 209;
      hourlyWage!.textContent = fmt(estimatedHourlyWage);
      dailyWage!.textContent = fmt(estimatedHourlyWage * 8);

      pension!.textContent = fmt(result.nationalPension);
      health!.textContent = fmt(result.healthInsurance);
      care!.textContent = fmt(result.longTermCare);
      employment!.textContent = fmt(result.employmentInsurance);
      incomeTax!.textContent = fmt(result.incomeTax);
      localTax!.textContent = fmt(result.localIncomeTax);
      totalDeductions!.textContent = fmt(result.totalDeductions);
    } catch (e) {
      error!.textContent =
        e instanceof Error ? e.message : '계산 중 오류가 발생했습니다.';
      error!.hidden = false;
    }
  };

  const setSelectedStyles = () => {
    [
      ['#under-60', '#under-60-label'],
      ['#age-60', '#age-60-label'],
    ].forEach(([input, label]) => {
      const checked = document.querySelector<HTMLInputElement>(input)?.checked;
      const el = document.querySelector<HTMLElement>(label);
      if (el) {
        el.classList.toggle('bg-primary', !!checked);
        el.classList.toggle('text-white', !!checked);
        el.classList.toggle('border-primary', !!checked);
        el.classList.toggle('bg-surface', !checked);
        el.classList.toggle('dark:bg-dark-surface-muted', !checked);
      }
    });
  };

  if (form && salary && taxFree && dependents && children && reset && copy) {
    document
      .querySelectorAll<HTMLInputElement>('input[name="age60"]')
      .forEach((input) => {
        input.addEventListener('change', setSelectedStyles);
      });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      render();
    });

    reset.addEventListener('click', () => {
      salary.value = '3,333,333';
      taxFree.value = '200,000';
      dependents.value = '1';
      children.value = '0';
      radio('#under-60')!.checked = true;
      setSelectedStyles();
      render();
    });

    copy.addEventListener('click', async () => {
      const text = [
        `월급: ${salary.value}원`,
        `비과세액: ${taxFree.value}원`,
        `월 실수령액: ${takeHome?.textContent}`,
        `공제액 합계: ${totalDeductions?.textContent}`,
      ].join('\n');

      try {
        await navigator.clipboard.writeText(text);
        copy.textContent = '복사 완료';
        setTimeout(() => (copy.textContent = '결과 복사'), 1000);
      } catch {
        copy.textContent = '복사 실패';
      }
    });

    bindNumberControls(form);
    bindLiveCalculation(form, render, { change: true });
    setSelectedStyles();
    render();
  }
</script>
