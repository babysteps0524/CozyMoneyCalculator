---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/common/Header.astro';
import Footer from '../../../components/common/Footer.astro';
import ToolShell from '../../../components/tools/ToolShell.astro';
---

<BaseLayout
  title="랜덤 숫자 생성기 | CozyMoney"
  description="원하는 범위에서 무작위 정수를 생성합니다."
  canonical="https://cozymoney.kr/tools/random/"
>
  <Header />
  <main class="cm-container" py="10 md:14 lg:18">
    <header max-w="3xl" mb="8 md:10">
      <p m="0" text="sm" font="700" text-primary>
        TOOLS
      </p>
      <h1 m="0" mt="2" text="3xl md:4xl" font="800" tracking-tight>
        랜덤 숫자 생성기
      </h1>
      <p
        m="0"
        mt="4"
        text="base md:lg"
        leading="7"
        text-text-muted
        dark="text-dark-text-muted"
      >
        원하는 범위에서 무작위 정수를 생성합니다.
      </p>
    </header>
    <ToolShell
      kind="random"
      title="랜덤 숫자 생성기"
      description="최솟값과 최댓값을 지정해 랜덤 숫자를 생성합니다."
    />
  </main>
  <Footer />
</BaseLayout>
