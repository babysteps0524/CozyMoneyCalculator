---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/common/Header.astro';
import Footer from '../../components/common/Footer.astro';

const tools = [
  ['로또 번호 생성기', '1~45 사이 6개 번호를 무작위로 생성', '/tools/lotto/'],
  ['랜덤 숫자 생성기', '원하는 범위의 랜덤 숫자 생성', '/tools/random/'],
  ['랜덤 추첨기', '목록에서 무작위 항목 추첨', '/tools/picker/'],
  ['비밀번호 생성기', '조건에 맞는 무작위 비밀번호 생성', '/tools/password/'],
  ['날짜 계산기', '두 날짜 사이의 기간 계산', '/tools/date/'],
  ['D-Day 계산기', '목표 날짜까지 남은 기간 계산', '/tools/dday/'],
  ['나이 계산기', '생년월일 기준 만 나이 계산', '/tools/age/'],
  ['단위 변환기', '길이·무게·온도·넓이·데이터 변환', '/tools/unit/'],
  ['퍼센트 계산기', '비율·증감률·할인율·증가율 계산', '/tools/percent/'],
];
---

<BaseLayout
  title="생활도구 | CozyMoney 코지머니"
  description="로또 번호 생성기, 랜덤 숫자 생성기, 추첨기, 비밀번호, 날짜, D-Day, 나이, 단위, 퍼센트 도구를 제공합니다."
  canonical="https://cozymoney.kr/tools/"
>
  <Header />
  <main class="cm-container" py="10 md:14 lg:18">
    <header max-w="3xl" mb="8 md:10">
      <p m="0" text="sm" font="700" text-primary>
        LIFE TOOLS
      </p>
      <h1 m="0" mt="2" text="3xl md:4xl" font="800" tracking-tight>
        생활에 필요한 도구
      </h1>
      <p
        m="0"
        mt="4"
        text="base md:lg"
        leading="7"
        text-text-muted
        dark="text-dark-text-muted"
      >
        계산 외에도 일상에서 자주 사용하는 랜덤, 날짜, 나이, 단위, 퍼센트 도구를
        간단하게 이용할 수 있습니다.
      </p>
    </header>
    <div grid="~ cols-1 sm:cols-2 lg:cols-3" gap="3 md:4">
      {tools.map(([title, description, href]) => (
        <a href={href} class="cm-card-interactive" p="5 md:6" no-underline>
          <div flex="~" items-center justify-between>
            <h2 m="0" text="lg" font="750" text-text dark="text-dark-text">
              {title}
            </h2>
            <span text="text-subtle" dark="text-dark-text-subtle">
              →
            </span>
          </div>
          <p
            m="0"
            mt="2"
            text="sm"
            leading="6"
            text-text-muted
            dark="text-dark-text-muted"
          >
            {description}
          </p>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
