---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/common/Header.astro';
import Footer from '../../../components/common/Footer.astro';
import ToolShell from '../../../components/tools/ToolShell.astro';
import { tools } from '../../../data/tools';

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.kind },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const canonical = `https://cozymoney.kr/tools/${tool.kind}/`;
---

<BaseLayout
  title={`${tool.title} | CozyMoney 코지머니`}
  description={tool.description}
  canonical={canonical}
>
  <Header />
  <main class="cm-container" py="10 md:14 lg:18">
    <header max-w="3xl" mb="8 md:10">
      <p m="0" text="sm" font="700" text-primary>
        TOOLS
      </p>
      <h1 m="0" mt="2" text="3xl md:4xl" font="800" tracking-tight>
        {tool.title}
      </h1>
      <p
        m="0"
        mt="4"
        text="base md:lg"
        leading="7"
        text-text-muted
        dark="text-dark-text-muted"
      >
        {tool.description}
      </p>
    </header>
    <ToolShell
      kind={tool.kind}
      title={tool.title}
      description={tool.pageDescription}
    />
  </main>
  <Footer />
</BaseLayout>
