---
interface Props {
  title: string;
  description: string;
  canonical?: string;
}

const { title, description, canonical = 'https://cozymoney.kr/' } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1902497629653128"
      crossorigin="anonymous"
    ></script>
    <meta
      name="naver-site-verification"
      content="14f9092843ad0446deac0e52ce19648db31d1085"
    />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link
      id="pretendard-preload"
      rel="preload"
      as="style"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <script is:inline>
      const pretendard = document.getElementById('pretendard-preload');
      if (pretendard) {
        pretendard.addEventListener('load', () => {
          pretendard.rel = 'stylesheet';
        });
      }
    </script>
    <noscript>
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
      />
    </noscript>
    <title>{title}</title>
    {import.meta.env.PUBLIC_ADSENSE_CLIENT && (
      <meta
        name="google-adsense-account"
        content={import.meta.env.PUBLIC_ADSENSE_CLIENT}
      />
    )}
    {import.meta.env.PUBLIC_ADSENSE_CLIENT && (
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_CLIENT}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>

  <body
    m="0"
    min-h="screen"
    bg="surface"
    text="text"
    font="sans"
    antialiased
    dark="bg-dark-surface text-dark-text"
  >
    <slot />
  </body>
</html>
